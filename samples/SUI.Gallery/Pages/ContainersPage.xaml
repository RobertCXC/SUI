<UserControl
    x:Class="SUI.Gallery.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sui="clr-namespace:SUI;assembly=SUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="420" Margin="24" HorizontalAlignment="Left">
            <TextBlock FontSize="20" Text="容器与反馈" />

            <TextBlock Margin="0,16,0,8" Text="TabControl" />
            <TabControl Height="100">
                <TabItem Header="常规"><TextBlock Margin="12" Text="内容 1" /></TabItem>
                <TabItem Header="高级"><TextBlock Margin="12" Text="内容 2" /></TabItem>
                <TabItem Header="禁用" IsEnabled="False" />
            </TabControl>

            <TextBlock Margin="0,16,0,8" Text="ListBox" />
            <ListBox Height="120" SelectionMode="Extended">
                <ListBoxItem Content="项目 1" IsSelected="True" />
                <ListBoxItem Content="项目 2" IsSelected="True" />
                <ListBoxItem Content="项目 3" />
            </ListBox>

            <TextBlock Margin="0,16,0,8" Text="Menu / ContextMenu / ToolTip" />
            <Menu>
                <MenuItem Header="文件">
                    <MenuItem Header="打开" InputGestureText="Ctrl+O" />
                    <MenuItem Header="保存" InputGestureText="Ctrl+S" />
                    <Separator />
                    <MenuItem Header="退出" />
                </MenuItem>
                <MenuItem Header="编辑" />
            </Menu>
            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="悬停看 ToolTip，右键看菜单" ToolTip="这是一个 ToolTip">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制" />
                        <MenuItem Header="粘贴" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TextBlock Margin="0,16,0,8" Text="ProgressBar" />
            <ProgressBar Margin="0,0,0,8" Value="60" />
            <ProgressBar IsIndeterminate="True" />

            <TextBlock Margin="0,16,0,8" Text="Expander" />
            <Expander Header="展开详情">
                <TextBlock Margin="12" Text="详情内容" />
            </Expander>

            <TextBlock Margin="0,16,0,8" Text="SUICard" />
            <sui:SUICard Title="项目状态" Description="可复用的卡片" IconText="S" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
