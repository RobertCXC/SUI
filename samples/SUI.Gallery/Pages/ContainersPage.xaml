<UserControl
    x:Class="SUI.Gallery.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sui="clr-namespace:SUI;assembly=SUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="32,28" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Gallery.PageTitle}" Text="容器与反馈" />
            <TextBlock Style="{StaticResource Gallery.PageSubtitle}" Text="标签页、菜单、提示、进度条与卡片。" />

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="TabControl" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="选中标签带强调色下划线。" />
                    <TabControl Height="110">
                        <TabItem Header="常规"><TextBlock Margin="0,12" Text="常规内容" /></TabItem>
                        <TabItem Header="高级"><TextBlock Margin="0,12" Text="高级内容" /></TabItem>
                        <TabItem Header="禁用" IsEnabled="False" />
                    </TabControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="Menu / ContextMenu / ToolTip" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="点击菜单、右键按钮、悬停按钮分别查看对应样式。" />
                    <Menu Margin="0,0,0,12" HorizontalAlignment="Left">
                        <MenuItem Header="文件">
                            <MenuItem Header="打开" InputGestureText="Ctrl+O" />
                            <MenuItem Header="保存" InputGestureText="Ctrl+S" />
                            <Separator />
                            <MenuItem Header="退出" />
                        </MenuItem>
                        <MenuItem Header="编辑" />
                    </Menu>
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,12,0"
                                Content="长文本 ToolTip / 右键菜单"
                                ToolTip="这是一个较长的 ToolTip 字符串，用于验证提示文字会在三百二十像素的最大宽度内自动换行并完整显示。">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制" />
                                    <MenuItem Header="粘贴" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="自定义 ToolTip 内容">
                            <Button.ToolTip>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="自定义提示内容" />
                                    <TextBlock Margin="0,4,0,0" Text="自定义内容也可以包含较长的多行文字，并使用相同的提示框样式。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="ProgressBar" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="确定进度（0 / 50 / 100）与不确定进度。" />
                    <ProgressBar Margin="0,0,0,12" Value="0" />
                    <ProgressBar Margin="0,0,0,12" Value="50" />
                    <ProgressBar Margin="0,0,0,12" Value="100" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="SUICard" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="可复用的信息卡片。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <sui:SUICard Title="项目状态" Description="可复用的卡片" IconText="S" />
                        <sui:SUICard Title="设备在线" Grid.Column="2" Description="12 台设备运行正常" IconText="D" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
