<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.ContainersPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / FEEDBACK"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="容器与反馈"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="组织内容，也传达状态。用卡片承载摘要，用标签页建立层次，用及时反馈串联操作。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <g:Example
                Title="信息卡片"
                Description="图标、标题与描述组成清晰的信息摘要，适应不同宽度的内容区域。"
                Hint="查看双列卡片与长描述卡片，比较不同内容的展示效果。">
                <demo:InformationCards />
            </g:Example>
            <g:Example
                Title="分组内容"
                Description="用标签页组织同级信息，点击切换；禁用标签不会接收输入。"
                Hint="选中标签以强调色下划线标识。Tab 与方向键可用于键盘操作。">
                <demo:ContentTabs />
            </g:Example>
            <g:Example
                Title="命令、上下文与提示"
                Description="展开菜单或右键按钮，尝试子菜单、选中项与禁用项。悬停按钮查看两种 ToolTip。"
                Hint="焦点位于本页时，也可使用 Ctrl+N / Ctrl+S 体验新建和保存的操作反馈。">
                <demo:MenusAndTooltips />
            </g:Example>
            <g:Example
                Title="任务进度"
                Description="启动模拟任务，体验确定进度、暂停与完成。没有可计算的进度时，使用不确定状态。"
                Hint="模拟任务只更新本页状态；切换页面会暂停计时，隐藏后的不确定进度条停止动画。">
                <demo:TaskProgressDemo />
            </g:Example>
        </StackPanel>
    </ScrollViewer>
</UserControl>
