<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.ButtonsPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / ACTION"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="按钮与命令"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="让操作的主次一目了然。选择合适的视觉权重，用清晰反馈完成一次交互。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <g:Example
                Title="四种权重，一个操作语言"
                Description="点击任意可用按钮查看反馈；悬停、按住或使用 Tab 键，检查真实控件状态。"
                Hint="一个操作区域建议只保留一个 Primary。Danger 用于需要特别注意的操作。">
                <demo:ButtonVariants />
            </g:Example>
            <g:Example
                Title="交互试验台"
                Description="换一段文字、切换变体或禁用按钮，观察同一个控件如何响应。"
                Hint="修改按钮文字、切换视觉变体或禁用按钮，直接观察外观与交互变化。">
                <demo:ButtonPlayground />
            </g:Example>
            <g:Example
                Title="有状态的操作"
                Description="ToggleButton 保留选择状态，适合视图选项和工具栏。"
                Hint="Tab 移动焦点；Space 切换状态。选中与禁用可以独立组合。">
                <demo:ToggleStates />
            </g:Example>
        </StackPanel>
    </ScrollViewer>
</UserControl>