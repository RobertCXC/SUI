<UserControl
    x:Class="SUI.Gallery.Pages.ButtonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="20" Text="Button" />

            <TextBlock Margin="0,16,0,8" Text="默认（隐式样式）" />
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="普通按钮" />
                <Button Margin="0,0,8,0" Content="禁用" IsEnabled="False" />
                <Button Margin="0,0,8,0" Content="默认按钮" IsDefault="True" />
                <ToggleButton Content="ToggleButton" />
            </StackPanel>

            <!-- 变体样式（SUI.Button.Primary / Ghost / Danger）完成后在此添加。 -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
