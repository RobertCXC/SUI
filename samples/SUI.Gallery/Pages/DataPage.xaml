<UserControl
    x:Class="SUI.Gallery.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <HierarchicalDataTemplate x:Key="SUITreeNodeTemplate" ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,4,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource SUI.Font.Size.Caption}"
                           Foreground="{StaticResource SUI.Brush.TextSecondary}"
                           Text="{Binding OI}"
                           TextAlignment="Right"
                           ToolTip="对象标识（OI）">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OI}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Gallery.PageTitle}" Text="数据" />
            <TextBlock Style="{StaticResource Gallery.PageSubtitle}" Text="TreeView、DataGrid 与 GridSplitter。拖动分隔线可调整区域大小。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" MinHeight="80" />
                </Grid.RowDefinitions>

                <TreeView x:Name="Tree"
                          Grid.Row="0"
                          Padding="4"
                          ItemContainerStyle="{StaticResource Gallery.TreeItem}"
                          ItemTemplate="{StaticResource SUITreeNodeTemplate}" />

                <GridSplitter Grid.Row="1"
                              Height="12"
                              Style="{StaticResource SUI.GridSplitter.Horizontal}" />

                <Border Grid.Row="2"
                        Background="{StaticResource SUI.Brush.SurfaceAlt}"
                        BorderBrush="{StaticResource SUI.Brush.Border}"
                        BorderThickness="{StaticResource SUI.Border.Thickness}"
                        CornerRadius="{StaticResource SUI.Radius.Panel}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                               Text="拖动上方分隔线调整高度" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="16"
                          HorizontalAlignment="Center"
                          Style="{StaticResource CustomGridSplitterStyle}" />

            <DataGrid x:Name="Grid"
                      Grid.Column="2"
                      AutoGenerateColumns="True"
                      SelectedIndex="0"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow" />
        </Grid>
    </Grid>
</UserControl>
