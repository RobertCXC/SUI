<UserControl
    x:Class="SUI.Gallery.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <HierarchicalDataTemplate x:Key="SUITreeNodeTemplate" ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,4,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource SUI.Font.Size.Caption}"
                           Foreground="{StaticResource SUI.Brush.TextSecondary}"
                           Text="{Binding OI}"
                           TextAlignment="Right"
                           ToolTip="对象标识（OI）">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OI}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" FontSize="20" Text="TreeView / DataGrid / GridSplitter" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>

            <TreeView
                x:Name="Tree"
                Grid.Row="0"
                ItemTemplate="{StaticResource SUITreeNodeTemplate}" />

            <GridSplitter
                Grid.Row="1"
                Height="8"
                Style="{StaticResource SUI.GridSplitter.Horizontal}" />

            <Border
                Grid.Row="2"
                Background="{StaticResource SUI.Brush.SurfaceAlt}"
                BorderBrush="{StaticResource SUI.Brush.Border}"
                BorderThickness="{StaticResource SUI.Border.Thickness}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SUI.Brush.TextSecondary}"
                    Text="拖动分隔线调整上下区域" />
            </Border>
        </Grid>

        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            Style="{StaticResource CustomGridSplitterStyle}" />

        <DataGrid
            x:Name="Grid"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,16,0,0"
            AutoGenerateColumns="True"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            SelectedIndex="0" />
    </Grid>
</UserControl>
