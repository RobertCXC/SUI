<UserControl
    x:Class="SUI.Gallery.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" FontSize="20" Text="TreeView / DataGrid / GridSplitter" />

        <TreeView
            x:Name="Tree"
            Grid.Row="1"
            Margin="0,16,0,0"
            ItemContainerStyle="{StaticResource SUITreeViewItemStyle}"
            ItemTemplate="{StaticResource SUITreeNodeTemplate}" />

        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            Width="8"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            Style="{StaticResource CustomGridSplitterStyle}" />

        <DataGrid
            x:Name="Grid"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,16,0,0"
            AutoGenerateColumns="True"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            SelectedIndex="0" />
    </Grid>
</UserControl>
