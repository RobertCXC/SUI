<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.DataPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / DATA"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="数据与布局"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="把分散的信息组织成可操作的工作区。树形导航、数据表格与分隔布局协同工作。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <Border
                Style="{StaticResource Gallery.SectionCard}">
                <UniformGrid
                    Columns="3">
                    <StackPanel>
                        <TextBlock
                            Text="示例设备"
                            Style="{StaticResource Gallery.Label}" />
                        <TextBlock
                            Text="200"
                            FontSize="28"
                            FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
                            Text="在线"
                            Style="{StaticResource Gallery.Label}" />
                        <TextBlock
                            Text="134"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SUI.Brush.Success}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
                            Text="离线"
                            Style="{StaticResource Gallery.Label}" />
                        <TextBlock
                            Text="66"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SUI.Brush.TextSecondary}" />
                    </StackPanel>
                </UniformGrid>
            </Border>
            <g:Example
                Title="设备工作区"
                Description="点击树中的在线 / 离线节点筛选；点击表头排序；按住 Ctrl 或 Shift 选择多行。表头背景延伸到右侧滚动条槽位。"
                Hint="拖动树与表格之间的竖线，或树下方的横线，调整工作区布局。">
                <demo:DeviceWorkspace />
            </g:Example>
            <Border
                Style="{StaticResource Gallery.Note}">
                <StackPanel>
                    <TextBlock
                        Text="键盘也能完成工作"
                        FontWeight="SemiBold"
                        Margin="0,0,0,6" />
                    <TextBlock
                        Text="表格：方向键移动，Ctrl+C 复制选中行（含表头）。树：左右方向键展开与收起。点击外部输入框后，表格选中状态仍然清晰可见。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
