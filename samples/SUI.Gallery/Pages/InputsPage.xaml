<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sui="clr-namespace:SUI;assembly=SUI"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.InputsPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / INPUT"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="输入与选择"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="从输入一段文字到完成一份设置。清晰的标签、可见的焦点和及时的校验，让每一步都有把握。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <g:Example
                Title="文本输入的每一种状态"
                Description="体验占位提示（TextBoxAssist.PlaceholderText）、紧凑输入（SUI.TextBox.Compact / SUI.ComboBox.Compact）、多行、密码、只读和禁用状态。"
                Hint="只读内容仍可选择和复制；禁用控件不参与键盘导航。">
                <demo:TextInputs />
            </g:Example>
            <g:Example
                Title="数值输入 NumberBox"
                Description="支持整数与小数、范围限制、上下步进按钮、键盘方向键与聚焦滚轮微调。"
                Hint="清空或输入越界数值后按 Enter 或移开焦点，观察自动规范化效果。">
                <WrapPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="单文件上限 (MiB)" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="160" Minimum="1" Maximum="1024" Step="16" Value="64" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="阈值比例 (小数)" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="160" Minimum="0" Maximum="1" Step="0.05" DecimalPlaces="2" Value="0.75" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="允许空值 (无按钮)" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="160" Minimum="0" Maximum="9999" AllowEmpty="True" ShowButtons="False" PlaceholderText="留空表示不限制" Value="{x:Null}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="只读状态" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="140" Value="42" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="禁用状态" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="140" Value="30" IsEnabled="False" />
                    </StackPanel>
                </WrapPanel>
            </g:Example>
            <g:Example
                Title="校验与操作反馈"
                Description="把名称清空或缩短到两个字符以内，体验校验边框与错误提示。"
                Hint="输入 3–24 个字符后保存；不符合要求时会显示错误提示。">
                <demo:InputValidation />
            </g:Example>
            <g:Example
                Title="下拉选择"
                Description="固定选项、自由输入与禁用状态。下拉项最小高度为 28，左右内边距为 6，上下为 0。用方向键切换，用 Esc 收起下拉面板。"
                Hint="普通下拉框点击任意位置展开；可编辑框仅右侧展开，输入区域滚轮逐项切换（跳过禁用项，到边界停止），仍允许输入自定义值；长列表自动显示滚动条。">
                <demo:ComboChoices />
            </g:Example>
            <g:Example
                Title="偏好设置"
                Description="复选、单选与开关具有不同的语义。试着调整设置，状态会立即映射到下方摘要。"
                Hint="复选允许多选，单选用于互斥方案；开关适合立即生效的设置。">
                <demo:PreferenceSettings />
            </g:Example>
            <g:Example
                Title="筛选药丸（Filter Pill）"
                Description="使用 SUI.RadioButton.Pill 实现互斥分栏筛选，使用 SUI.ToggleButton.Pill 实现多条件标签筛选。"
                Hint="支持键盘焦点、悬停、按下与禁用态；单选药丸可配合 EqualityConverter 双向绑定枚举、数值或字符串。">
                <StackPanel>
                    <TextBlock Text="单选分栏筛选（SUI.RadioButton.Pill）" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,16">
                        <RadioButton Content="全部工具" GroupName="GalleryFilterPill" IsChecked="True" Style="{StaticResource SUI.RadioButton.Pill}" Margin="0,0,8,8" />
                        <RadioButton Content="纯本地" GroupName="GalleryFilterPill" Style="{StaticResource SUI.RadioButton.Pill}" Margin="0,0,8,8" />
                        <RadioButton Content="需串口" GroupName="GalleryFilterPill" Style="{StaticResource SUI.RadioButton.Pill}" Margin="0,0,8,8" />
                        <RadioButton Content="已禁用" GroupName="GalleryFilterPill" IsEnabled="False" Style="{StaticResource SUI.RadioButton.Pill}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="多选条件药丸（SUI.ToggleButton.Pill）" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <ToggleButton Content="仅看在线" IsChecked="True" Style="{StaticResource SUI.ToggleButton.Pill}" Margin="0,0,8,0" />
                        <ToggleButton Content="自动重连" Style="{StaticResource SUI.ToggleButton.Pill}" Margin="0,0,8,0" />
                        <ToggleButton Content="十六进制显示" IsChecked="True" Style="{StaticResource SUI.ToggleButton.Pill}" Margin="0,0,8,0" />
                        <ToggleButton Content="不可用" IsEnabled="False" Style="{StaticResource SUI.ToggleButton.Pill}" />
                    </WrapPanel>
                </StackPanel>
            </g:Example>
            <g:Example
                Title="日期与时间选择（DatePicker / TimePicker）"
                Description="原生 DatePicker 与 Calendar 已提供 SUI 隐式样式；TimePicker 支持直接输入与下拉分栏选择（时/分/秒）。"
                Hint="DatePicker 支持 sui:TextBoxAssist.PlaceholderText；TimePicker 支持按 Enter 提交、Esc 撤销与步长配置。">
                <WrapPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="开始日期（DatePicker）" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <DatePicker Width="180" sui:TextBoxAssist.PlaceholderText="选择开始日期" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="禁用日期" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <DatePicker Width="160" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="时间选择（HH:mm，5 分步长）" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:TimePicker Width="160" MinuteIncrement="5" PlaceholderText="选择执行时间" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="含秒数（HH:mm:ss）" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:TimePicker Width="170" ShowSeconds="True" SelectedTime="09:30:15" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="只读时间" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:TimePicker Width="140" IsReadOnly="True" SelectedTime="18:00:00" />
                    </StackPanel>
                </WrapPanel>
            </g:Example>
            <g:Example
                Title="本地文件选择与拖放（FileUpload）"
                Description="内置 Win32 OpenFileDialog 扩展名过滤、单选/多选与资源管理器拖放校验，自动列出已选文件并支持逐项移除。"
                Hint="点击「浏览文件」或直接从资源管理器拖入 .bin / .txt 文件体验效果；非目标扩展名拖入时会被拒绝。">
                <StackPanel>
                    <sui:FileUpload
                        Title="选择固件或配置文件（单选）"
                        Description="支持 .bin、.txt 文件；点击按钮或直接拖放到此区域"
                        Filter="固件与文本 (*.bin;*.txt)|*.bin;*.txt|所有文件 (*.*)|*.*"
                        Margin="0,0,0,12" />
                    <sui:FileUpload
                        Title="批量选择附件（多选）"
                        Description="允许一次选择或拖入多个文件，支持逐项移除或一键清空"
                        AllowMultiple="True"
                        ButtonText="添加文件" />
                </StackPanel>
            </g:Example>
            <g:Example
                Title="列表与滚动"
                Description="按住 Ctrl 多选，按住 Shift 连选；竖向列表和横向文本都使用统一的细滑块。悬停或拖动时滑块加宽、加深。"
                Hint="可拖动滚动条滑块或使用滚轮；内部列表滚动到边界后，可将指针移至外侧继续滚动页面。">
                <demo:ListAndScroll />
            </g:Example>
        </StackPanel>
    </ScrollViewer>
</UserControl>
