<UserControl
    x:Class="SUI.Gallery.Pages.InputsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="360" Margin="24" HorizontalAlignment="Left">
            <TextBlock FontSize="{StaticResource SUI.Font.Size.Title}" Text="输入与选择" />

            <TextBlock Margin="0,16,0,8" Text="TextBox / PasswordBox" />
            <TextBox Margin="0,0,0,8" Text="中文输入 Text" />
            <TextBox Height="72" Margin="0,0,0,8" AcceptsReturn="True" Text="多行输入第一行&#x0a;第二行" TextWrapping="Wrap" />
            <TextBox Margin="0,0,0,8" IsReadOnly="True" Text="只读" />
            <TextBox Margin="0,0,0,8" IsEnabled="False" Text="禁用" />
            <PasswordBox Margin="0,0,0,8" Password="123456" />

            <TextBlock Margin="0,16,0,8" Text="ComboBox" />
            <ComboBox MaxDropDownHeight="128" Margin="0,0,0,8" SelectedIndex="0">
                <ComboBoxItem Content="COM1" />
                <ComboBoxItem Content="COM2" />
                <ComboBoxItem Content="COM3" />
                <ComboBoxItem Content="COM4" />
                <ComboBoxItem Content="COM5" />
                <ComboBoxItem Content="COM6（禁用）" IsEnabled="False" />
                <ComboBoxItem Content="COM7" />
                <ComboBoxItem Content="COM8" />
                <ComboBoxItem Content="COM9" />
                <ComboBoxItem Content="COM10" />
                <ComboBoxItem Content="COM11" />
                <ComboBoxItem Content="COM12" />
            </ComboBox>
            <ComboBox Margin="0,0,0,8" IsEditable="True" Text="可编辑" />
            <ComboBox IsEnabled="False" SelectedIndex="0">
                <ComboBoxItem Content="禁用" />
            </ComboBox>

            <TextBlock Margin="0,16,0,8" Text="ListBox / ScrollViewer" />
            <ListBox Height="128" Margin="0,0,0,8">
                <ListBoxItem Content="列表项 01" />
                <ListBoxItem Content="列表项 02" />
                <ListBoxItem Content="列表项 03" />
                <ListBoxItem Content="列表项 04" />
                <ListBoxItem Content="列表项 05" />
                <ListBoxItem Content="列表项 06" />
                <ListBoxItem Content="列表项 07" />
                <ListBoxItem Content="列表项 08" />
            </ListBox>
            <ScrollViewer Height="40" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="这是一个用于检查水平滚动条的长文本，左右拖动滚动条可以查看全部内容。" TextWrapping="NoWrap" />
            </ScrollViewer>

            <TextBlock Margin="0,16,0,8" Text="CheckBox / RadioButton / Switch" />
            <CheckBox Margin="0,0,0,4" Content="选项 A" IsChecked="True" />
            <CheckBox Margin="0,0,0,4" Content="选项 B" />
            <CheckBox Margin="0,0,0,4" Content="不确定" IsThreeState="True" IsChecked="{x:Null}" />
            <CheckBox Margin="0,0,0,4" Content="禁用" IsEnabled="False" />
            <RadioButton Margin="0,8,0,4" Content="单选 1" GroupName="g" IsChecked="True" />
            <RadioButton Margin="0,0,0,4" Content="单选 2" GroupName="g" />
            <CheckBox
                Margin="0,8,0,4"
                Content="开关（开启）"
                IsChecked="True"
                Style="{StaticResource SwitchCheckBoxStyle}" />
            <CheckBox
                Margin="0,0,0,4"
                Content="开关（关闭）"
                Style="{StaticResource SwitchCheckBoxStyle}" />
            <CheckBox
                Margin="0,0,0,4"
                Content="开关（三态 null）"
                IsThreeState="True"
                IsChecked="{x:Null}"
                Style="{StaticResource SwitchCheckBoxStyle}" />
            <CheckBox
                Content="开关（禁用）"
                IsEnabled="False"
                Style="{StaticResource SwitchCheckBoxStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
