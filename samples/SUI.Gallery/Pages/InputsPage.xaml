<UserControl
    x:Class="SUI.Gallery.Pages.InputsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="32,28" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Gallery.PageTitle}" Text="输入与选择" />
            <TextBlock Style="{StaticResource Gallery.PageSubtitle}" Text="文本输入、下拉选择、列表以及复选、单选、开关控件。" />

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="文本输入" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="TextBox 与 PasswordBox，聚焦时底边加粗为强调色。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="单行" />
                            <TextBox Margin="0,0,0,12" Text="中文输入 Text" />
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="密码" />
                            <PasswordBox Margin="0,0,0,12" Password="123456" />
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="只读" />
                            <TextBox Margin="0,0,0,12" IsReadOnly="True" Text="只读内容" />
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="禁用" />
                            <TextBox IsEnabled="False" Text="禁用内容" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="多行" />
                            <TextBox Height="132" AcceptsReturn="True" Text="多行输入第一行&#x0a;第二行" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="ComboBox" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="不可编辑、可编辑与禁用三种模式。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="下拉选择" />
                            <ComboBox MaxDropDownHeight="160" SelectedIndex="0">
                                <ComboBoxItem Content="COM1" />
                                <ComboBoxItem Content="COM2" />
                                <ComboBoxItem Content="COM3" />
                                <ComboBoxItem Content="COM4（禁用）" IsEnabled="False" />
                                <ComboBoxItem Content="COM5" />
                                <ComboBoxItem Content="COM6" />
                                <ComboBoxItem Content="COM7" />
                                <ComboBoxItem Content="COM8" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="可编辑" />
                            <ComboBox IsEditable="True" Text="可编辑">
                                <ComboBoxItem Content="115200" />
                                <ComboBoxItem Content="9600" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="禁用" />
                            <ComboBox IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="禁用" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="列表与滚动条" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="ListBox 选中态，以及水平滚动条样式。" />
                    <ListBox Height="140" Margin="0,0,0,12" SelectedIndex="1">
                        <ListBoxItem Content="列表项 01" />
                        <ListBoxItem Content="列表项 02" />
                        <ListBoxItem Content="列表项 03" />
                        <ListBoxItem Content="列表项 04" />
                        <ListBoxItem Content="列表项 05" />
                        <ListBoxItem Content="列表项 06" />
                        <ListBoxItem Content="列表项 07" />
                        <ListBoxItem Content="列表项 08" />
                    </ListBox>
                    <ScrollViewer Height="44" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <TextBlock Text="这是一个用于检查水平滚动条的长文本，左右拖动滚动条可以查看全部内容，滚动条应保持细长的样式。" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Gallery.SectionTitle}" Text="CheckBox / RadioButton / Switch" />
                    <TextBlock Style="{StaticResource Gallery.SectionDesc}" Text="用 Space 键切换，Tab 键查看焦点外框。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="CheckBox" />
                            <CheckBox Margin="0,0,0,6" Content="选项 A" IsChecked="True" />
                            <CheckBox Margin="0,0,0,6" Content="选项 B" />
                            <CheckBox Margin="0,0,0,6" Content="不确定" IsChecked="{x:Null}" IsThreeState="True" />
                            <CheckBox Content="禁用" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="RadioButton" />
                            <RadioButton Margin="0,0,0,6" Content="单选 1" GroupName="g" IsChecked="True" />
                            <RadioButton Margin="0,0,0,6" Content="单选 2" GroupName="g" />
                            <RadioButton Content="禁用" GroupName="g" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Gallery.Label}" Text="Switch" />
                            <CheckBox Margin="0,0,0,6" Content="开启" IsChecked="True" Style="{StaticResource SwitchCheckBoxStyle}" />
                            <CheckBox Margin="0,0,0,6" Content="关闭" Style="{StaticResource SwitchCheckBoxStyle}" />
                            <CheckBox Content="禁用" IsEnabled="False" Style="{StaticResource SwitchCheckBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
