<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.InputsPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / INPUT"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="输入与选择"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="从输入一段文字到完成一份设置。清晰的标签、可见的焦点和及时的校验，让每一步都有把握。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <g:Example
                Title="文本输入的每一种状态"
                Description="体验单行、多行、密码、只读和禁用状态。点击输入框，观察焦点底边。"
                Hint="只读内容仍可选择和复制；禁用控件不参与键盘导航。">
                <demo:TextInputs />
            </g:Example>
            <g:Example
                Title="校验与操作反馈"
                Description="把名称清空或缩短到两个字符以内，体验校验边框与错误提示。"
                Hint="输入 3–24 个字符后保存；不符合要求时会显示错误提示。">
                <demo:InputValidation />
            </g:Example>
            <g:Example
                Title="下拉选择"
                Description="固定选项、自由输入与禁用状态。用方向键切换，用 Esc 收起下拉面板。"
                Hint="可编辑 ComboBox 允许输入列表中没有的值；右侧下拉触发区域已加宽，点击箭头周围也可展开；长列表会自动显示滚动条。">
                <demo:ComboChoices />
            </g:Example>
            <g:Example
                Title="偏好设置"
                Description="复选、单选与开关具有不同的语义。试着调整设置，状态会立即映射到下方摘要。"
                Hint="复选允许多选，单选用于互斥方案；开关适合立即生效的设置。">
                <demo:PreferenceSettings />
            </g:Example>
            <g:Example
                Title="列表与滚动"
                Description="按住 Ctrl 多选，按住 Shift 连选；竖向列表和横向文本都使用统一的细滑块。悬停或拖动时滑块加宽、加深。"
                Hint="可拖动滚动条滑块或使用滚轮；内部列表滚动到边界后，可将指针移至外侧继续滚动页面。">
                <demo:ListAndScroll />
            </g:Example>
        </StackPanel>
    </ScrollViewer>
</UserControl>
