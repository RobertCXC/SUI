<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sui="clr-namespace:SUI;assembly=SUI"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.InputsPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / INPUT"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="输入与选择"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="从输入一段文字到完成一份设置。清晰的标签、可见的焦点和及时的校验，让每一步都有把握。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <g:Example
                Title="文本输入的每一种状态"
                Description="体验单行、多行、密码、只读和禁用状态。点击输入框，观察焦点底边。"
                Hint="只读内容仍可选择和复制；禁用控件不参与键盘导航。">
                <demo:TextInputs />
            </g:Example>
            <g:Example
                Title="数值输入 NumberBox"
                Description="支持整数与小数、范围限制、上下步进按钮、键盘方向键与聚焦滚轮微调。"
                Hint="清空或输入越界数值后按 Enter 或移开焦点，观察自动规范化效果。">
                <WrapPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="单文件上限 (MiB)" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="160" Minimum="1" Maximum="1024" Step="16" Value="64" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="阈值比例 (小数)" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="160" Minimum="0" Maximum="1" Step="0.05" DecimalPlaces="2" Value="0.75" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,12">
                        <TextBlock Text="允许空值 (无按钮)" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="160" Minimum="0" Maximum="9999" AllowEmpty="True" ShowButtons="False" PlaceholderText="留空表示不限制" Value="{x:Null}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="禁用状态" Style="{StaticResource SUI.Text.Caption}" Margin="0,0,0,6" />
                        <sui:SUINumberBox Width="140" Value="30" IsEnabled="False" />
                    </StackPanel>
                </WrapPanel>
            </g:Example>
            <g:Example
                Title="校验与操作反馈"
                Description="把名称清空或缩短到两个字符以内，体验校验边框与错误提示。"
                Hint="输入 3–24 个字符后保存；不符合要求时会显示错误提示。">
                <demo:InputValidation />
            </g:Example>
            <g:Example
                Title="下拉选择"
                Description="固定选项、自由输入与禁用状态。下拉项最小高度为 28，左右内边距为 6，上下为 0。用方向键切换，用 Esc 收起下拉面板。"
                Hint="普通下拉框点击任意位置展开；可编辑框仅右侧展开，输入区域滚轮逐项切换（跳过禁用项，到边界停止），仍允许输入自定义值；长列表自动显示滚动条。">
                <demo:ComboChoices />
            </g:Example>
            <g:Example
                Title="偏好设置"
                Description="复选、单选与开关具有不同的语义。试着调整设置，状态会立即映射到下方摘要。"
                Hint="复选允许多选，单选用于互斥方案；开关适合立即生效的设置。">
                <demo:PreferenceSettings />
            </g:Example>
            <g:Example
                Title="列表与滚动"
                Description="按住 Ctrl 多选，按住 Shift 连选；竖向列表和横向文本都使用统一的细滑块。悬停或拖动时滑块加宽、加深。"
                Hint="可拖动滚动条滑块或使用滚轮；内部列表滚动到边界后，可将指针移至外侧继续滚动页面。">
                <demo:ListAndScroll />
            </g:Example>
        </StackPanel>
    </ScrollViewer>
</UserControl>
