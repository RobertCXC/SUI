<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sui="clr-namespace:SUI;assembly=SUI"
    xmlns:demo="clr-namespace:SuiExamples"
    xmlns:g="clr-namespace:SUI.Gallery.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SUI.Gallery.Pages.NavigationPage">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Style="{StaticResource Gallery.Page}">
            <TextBlock
                Text="COMPONENTS / NAVIGATION"
                Style="{StaticResource Gallery.Eyebrow}" />
            <TextBlock
                Text="应用导航"
                Style="{StaticResource Gallery.PageTitle}" />
            <TextBlock
                Text="体验紧凑侧栏与横向图文两种布局，帮助和设置等入口可以固定在侧栏底部。"
                Style="{StaticResource Gallery.PageSubtitle}" />
            <g:Example
                Title="紧凑导航与底部入口"
                Description="上方菜单可独立滚动，帮助和设置固定靠下。点击任意一组入口，右侧内容随之切换。"
                Hint="两组菜单共用一个选中状态；Tab 可在分组间移动，方向键切换组内入口。">
                <demo:CompactNavigation />
            </g:Example>
            <g:Example
                Title="横向图文与入口状态"
                Description="上方和底部入口共用横向图文布局。试试开关，隐藏底部帮助或启用底部设置。"
                Hint="禁用入口不能通过点击选中；示例会在当前入口被隐藏或禁用时回到总览。">
                <demo:CustomNavigation />
            </g:Example>
            <g:Example
                Title="独立二级导航列表（SUI.ListBox.Navigation）"
                Description="无需 SUINavigationView 壳时，可直接给 ListBox 指定 SUI.ListBox.Navigation 样式获得无外框、带左侧 3px Accent 选中条的分类菜单。"
                Hint="适合设置页或局部面板内部的二级分类列表，可自由组合图标与 SUIBadge。">
                <Border
                    Width="240"
                    HorizontalAlignment="Left"
                    Padding="0,6"
                    Background="{StaticResource SUI.Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource SUI.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SUI.Radius.Panel}">
                    <ListBox Style="{StaticResource SUI.ListBox.Navigation}" SelectedIndex="0">
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource SUI.Font.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="常规配置" VerticalAlignment="Center" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource SUI.Font.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="日志存储" VerticalAlignment="Center" />
                                <sui:SUIBadge Grid.Column="2" Content="128 MB" Variant="Info" Padding="6,1" Margin="8,0,0,0" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem IsEnabled="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource SUI.Font.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="插件扩展" VerticalAlignment="Center" />
                                <sui:SUIBadge Grid.Column="2" Content="占位" Variant="Warning" Padding="6,1" Margin="8,0,0,0" />
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </Border>
            </g:Example>
            <Border
                Style="{StaticResource Gallery.Note}">
                <StackPanel>
                    <TextBlock
                        Text="体验提示"
                        FontWeight="SemiBold"
                        Margin="0,0,0,6" />
                    <TextBlock
                        Text="试试滚动上方菜单，再切换到底部帮助或设置。隐藏底部入口或切换分类后，继续观察选中状态与内容。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
