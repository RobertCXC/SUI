<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.ShapeAndSpacing"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.Label"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
                Width="24" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock
                Text="圆角 / Corner radius"
                Style="{StaticResource Example.Label}" />
            <Border
                Background="{StaticResource SUI.Brush.SurfaceAlt}"
                BorderBrush="{StaticResource SUI.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource SUI.Radius.Control}"
                Padding="16"
                Margin="0,0,0,12">
                <TextBlock
                    Text="控件圆角 / 4 px" />
            </Border>
            <Border
                Background="{StaticResource SUI.Brush.SurfaceAlt}"
                BorderBrush="{StaticResource SUI.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource SUI.Radius.Panel}"
                Padding="16">
                <TextBlock
                    Text="面板圆角 / 8 px" />
            </Border>
        </StackPanel>
        <StackPanel
            Grid.Column="2">
            <TextBlock
                Text="间距 / Spacing scale"
                Style="{StaticResource Example.Label}" />
            <ItemsControl
                x:Name="Spacing">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel
                            Margin="0,0,0,12">
                            <TextBlock
                                Text="{Binding Label}"
                                Width="150"
                                Style="{StaticResource Example.Muted}" />
                            <Border
                                Width="{Binding Value}"
                                Height="16"
                                Background="{StaticResource SUI.Brush.Accent}"
                                HorizontalAlignment="Left"
                                CornerRadius="2" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>