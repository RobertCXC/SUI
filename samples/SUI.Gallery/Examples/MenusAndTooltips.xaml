<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.MenusAndTooltips"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.CommandBindings>
        <CommandBinding
            Command="ApplicationCommands.New"
            Executed="OnNew" />
        <CommandBinding
            Command="ApplicationCommands.Save"
            Executed="OnSave" />
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Menu
            Margin="0,0,0,20"
            HorizontalAlignment="Left">
            <MenuItem
                Header="文件(_F)">
                <MenuItem
                    Header="新建项目(_N)"
                    Command="ApplicationCommands.New" />
                <MenuItem
                    Header="保存(_S)"
                    Command="ApplicationCommands.Save" />
                <Separator />
                <MenuItem
                    Header="最近项目">
                    <MenuItem
                        Header="SUI 工作空间"
                        Click="OnMenuAction" />
                    <MenuItem
                        Header="组件试验台"
                        Click="OnMenuAction" />
                </MenuItem>
                <MenuItem
                    Header="导出（暂不可用）"
                    IsEnabled="False" />
            </MenuItem>
            <MenuItem
                Header="视图(_V)">
                <MenuItem
                    Header="显示网格"
                    IsCheckable="True"
                    IsChecked="True"
                    Click="OnMenuAction" />
                <MenuItem
                    Header="显示辅助线"
                    IsCheckable="True"
                    Click="OnMenuAction" />
            </MenuItem>
        </Menu>
        <WrapPanel>
            <Button
                Content="右键查看操作"
                Margin="0,0,12,8"
                ToolTip="这是上下文操作入口。右键可查看最近项目、选中状态和禁用项；提示内容会自动换行，以保持合适的阅读宽度。">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="打开项目"
                            Click="OnMenuAction" />
                        <MenuItem
                            Header="固定到最近列表"
                            IsCheckable="True"
                            Click="OnMenuAction" />
                        <Separator />
                        <MenuItem
                            Header="更多操作">
                            <MenuItem
                                Header="查看详情"
                                Click="OnMenuAction" />
                        </MenuItem>
                        <MenuItem
                            Header="归档（暂不可用）"
                            IsEnabled="False" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button
                Content="悬停查看丰富提示"
                Margin="0,0,12,8">
                <Button.ToolTip>
                    <StackPanel
                        MaxWidth="270">
                        <TextBlock
                            Text="一个小而有用的提示"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="ToolTip 也可以承载自定义布局，用标题和说明解释当前操作。"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                        <TextBlock
                            Text="保持简短，让用户继续工作。"
                            Style="{StaticResource Example.Muted}"
                            Margin="0,8,0,0" />
                    </StackPanel>
                </Button.ToolTip>
            </Button>
        </WrapPanel>
        <TextBlock
            x:Name="MenuResult"
            Text="等待命令 · 菜单操作的结果会显示在这里"
            Style="{StaticResource Example.Muted}"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>