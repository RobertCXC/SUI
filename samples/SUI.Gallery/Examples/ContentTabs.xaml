<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.ContentTabs"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.SectionTitle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Title}" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Margin"
                Value="0,0,0,6" />
        </Style>
        <Style
            x:Key="Example.Label"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <TabControl
        Height="174">
        <TabItem
            Header="项目概况"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid
                Margin="4,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        Text="SUI 设计系统"
                        Style="{StaticResource Example.SectionTitle}" />
                    <TextBlock
                        Text="原生 WPF 控件与视觉资源"
                        Style="{StaticResource Example.Muted}" />
                    <TextBlock
                        Text="持续迭代 · 面向桌面应用"
                        Margin="0,12,0,0" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1">
                    <TextBlock
                        Text="项目状态"
                        Style="{StaticResource Example.Label}" />
                    <TextBlock
                        Text="● 运行正常"
                        Foreground="{StaticResource SUI.Brush.Success}" />
                    <TextBlock
                        Text="下一步：完善你的应用体验"
                        Margin="0,12,0,0"
                        Style="{StaticResource Example.Muted}" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem
            Header="活动记录"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <StackPanel
                Margin="4,18">
                <TextBlock
                    Text="最近活动"
                    Style="{StaticResource Example.SectionTitle}" />
                <TextBlock
                    Text="09:41  已更新控件展示"
                    Margin="0,4" />
                <TextBlock
                    Text="09:30  主题资源同步完成"
                    Margin="0,4" />
                <TextBlock
                    Text="09:12  工作空间已创建"
                    Style="{StaticResource Example.Muted}" />
            </StackPanel>
        </TabItem>
        <TabItem
            Header="高级设置"
            IsEnabled="False" />
    </TabControl>
</UserControl>