<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.ButtonVariants"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.Label"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <StackPanel
        Button.Click="OnAction">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="150" />
                <ColumnDefinition
                    Width="150" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="52" />
                <RowDefinition
                    Height="52" />
                <RowDefinition
                    Height="52" />
                <RowDefinition
                    Height="52" />
            </Grid.RowDefinitions>
            <TextBlock
                Text="用途 / 样式"
                Style="{StaticResource Example.Label}" />
            <TextBlock
                Grid.Column="1"
                Text="可用"
                Style="{StaticResource Example.Label}" />
            <TextBlock
                Grid.Column="2"
                Text="禁用"
                Style="{StaticResource Example.Label}" />
            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Center">
                <TextBlock
                    Text="Default"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="一般操作 · 常用交互"
                    Style="{StaticResource Example.Muted}" />
            </StackPanel>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                Content="默认操作"
                Margin="0,8,16,8" />
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Content="默认操作"
                IsEnabled="False"
                Margin="0,8,0,8" />
            <StackPanel
                Grid.Row="2"
                VerticalAlignment="Center">
                <TextBlock
                    Text="Primary"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="主要操作 · 强调关键行动"
                    Style="{StaticResource Example.Muted}" />
            </StackPanel>
            <Button
                Grid.Row="2"
                Grid.Column="1"
                Content="保存更改"
                Style="{StaticResource SUI.Button.Primary}"
                Margin="0,8,16,8" />
            <Button
                Grid.Row="2"
                Grid.Column="2"
                Content="保存更改"
                Style="{StaticResource SUI.Button.Primary}"
                IsEnabled="False"
                Margin="0,8,0,8" />
            <StackPanel
                Grid.Row="3"
                VerticalAlignment="Center">
                <TextBlock
                    Text="Ghost"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="轻量操作 · 保持视觉轻盈"
                    Style="{StaticResource Example.Muted}" />
            </StackPanel>
            <Button
                Grid.Row="3"
                Grid.Column="1"
                Content="稍后处理"
                Style="{StaticResource SUI.Button.Ghost}"
                Margin="0,8,16,8" />
            <Button
                Grid.Row="3"
                Grid.Column="2"
                Content="稍后处理"
                Style="{StaticResource SUI.Button.Ghost}"
                IsEnabled="False"
                Margin="0,8,0,8" />
            <StackPanel
                Grid.Row="4"
                VerticalAlignment="Center">
                <TextBlock
                    Text="Danger"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="谨慎操作 · 提醒注意风险"
                    Style="{StaticResource Example.Muted}" />
            </StackPanel>
            <Button
                Grid.Row="4"
                Grid.Column="1"
                Content="移除项目"
                Style="{StaticResource SUI.Button.Danger}"
                Margin="0,8,16,8" />
            <Button
                Grid.Row="4"
                Grid.Column="2"
                Content="移除项目"
                Style="{StaticResource SUI.Button.Danger}"
                IsEnabled="False"
                Margin="0,8,0,8" />
        </Grid>
        <Border
            Background="{StaticResource SUI.Brush.SurfaceAlt}"
            Padding="12"
            Margin="0,16,0,0"
            CornerRadius="4">
            <TextBlock
                x:Name="ActionResult"
                Text="等待操作 · 点击按钮体验即时反馈"
                Style="{StaticResource Example.Muted}"
                AutomationProperties.LiveSetting="Polite" />
        </Border>
    </StackPanel>
</UserControl>