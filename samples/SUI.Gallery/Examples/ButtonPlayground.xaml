<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.ButtonPlayground"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.Label"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="*" />
            <ColumnDefinition
                Width="24" />
            <ColumnDefinition
                Width="240" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{StaticResource SUI.Brush.SurfaceAlt}"
            CornerRadius="8"
            MinHeight="180">
            <Button
                x:Name="Preview"
                Content="创建项目"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="OnPreviewClick" />
        </Border>
        <StackPanel
            Grid.Column="2">
            <TextBlock
                Text="按钮文字"
                Style="{StaticResource Example.Label}" />
            <TextBox
                x:Name="ButtonText"
                Text="创建项目"
                TextChanged="OnPlaygroundChanged"
                Margin="0,0,0,12"
                AutomationProperties.Name="按钮文字" />
            <TextBlock
                Text="视觉变体"
                Style="{StaticResource Example.Label}" />
            <ComboBox
                x:Name="Variant"
                SelectedIndex="1"
                SelectionChanged="OnPlaygroundChanged"
                Margin="0,0,0,12"
                AutomationProperties.Name="按钮变体">
                <ComboBoxItem
                    Content="Default" />
                <ComboBoxItem
                    Content="Primary" />
                <ComboBoxItem
                    Content="Ghost" />
                <ComboBoxItem
                    Content="Danger" />
            </ComboBox>
            <CheckBox
                x:Name="DisablePreview"
                Content="禁用预览按钮"
                Checked="OnPlaygroundChanged"
                Unchecked="OnPlaygroundChanged" />
            <TextBlock
                x:Name="PreviewResult"
                Text="已点击 0 次"
                Margin="0,12,0,0"
                Style="{StaticResource Example.Muted}" />
        </StackPanel>
    </Grid>
</UserControl>