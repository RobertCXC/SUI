<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.ComboChoices"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.Label"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
                Width="16" />
            <ColumnDefinition />
            <ColumnDefinition
                Width="16" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock
                Text="目标环境"
                Style="{StaticResource Example.Label}" />
            <ComboBox
                SelectedIndex="0"
                MaxDropDownHeight="160"
                AutomationProperties.Name="目标环境">
                <ComboBoxItem
                    Content="开发环境" />
                <ComboBoxItem
                    Content="测试环境" />
                <ComboBoxItem
                    Content="集成环境" />
                <ComboBoxItem
                    Content="预发布环境" />
                <ComboBoxItem
                    Content="生产环境（禁用）"
                    IsEnabled="False" />
                <ComboBoxItem
                    Content="本地沙盒" />
                <ComboBoxItem
                    Content="演示环境" />
            </ComboBox>
        </StackPanel>
        <StackPanel
            Grid.Column="2">
            <TextBlock
                Text="自定义配置"
                Style="{StaticResource Example.Label}" />
            <ComboBox
                IsEditable="True"
                Text="自定义配置"
                AutomationProperties.Name="自定义配置">
                <ComboBoxItem
                    Content="标准配置" />
                <ComboBoxItem
                    Content="高性能配置" />
            </ComboBox>
        </StackPanel>
        <StackPanel
            Grid.Column="4">
            <TextBlock
                Text="暂不可用"
                Style="{StaticResource Example.Label}" />
            <ComboBox
                IsEnabled="False"
                SelectedIndex="0">
                <ComboBoxItem
                    Content="由管理员管理" />
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>