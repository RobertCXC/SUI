<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.TaskProgressDemo"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid
            Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="36" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="28" />
                <RowDefinition
                    Height="28" />
                <RowDefinition
                    Height="28" />
            </Grid.RowDefinitions>
            <TextBlock
                Text="0%"
                Style="{StaticResource Example.Muted}" />
            <ProgressBar
                Grid.Column="1"
                Value="0"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Row="1"
                Text="50%"
                Style="{StaticResource Example.Muted}" />
            <ProgressBar
                Grid.Row="1"
                Grid.Column="1"
                Value="50"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Row="2"
                Text="100%"
                Style="{StaticResource Example.Muted}" />
            <ProgressBar
                Grid.Row="2"
                Grid.Column="1"
                Value="100"
                VerticalAlignment="Center" />
        </Grid>
        <DockPanel
            Margin="0,0,0,12">
            <TextBlock
                x:Name="ProgressLabel"
                Text="准备就绪 · 0%"
                VerticalAlignment="Center" />
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button
                    x:Name="StartButton"
                    MinWidth="96"
                    Content="开始任务"
                    Style="{StaticResource SUI.Button.Primary}"
                    Click="OnStart"
                    Margin="12,0,8,0" />
                <Button
                    Content="重置"
                    Click="OnReset" />
            </StackPanel>
        </DockPanel>
        <ProgressBar
            x:Name="TaskProgress"
            Value="0"
            Margin="0,0,0,24" />
        <CheckBox
            x:Name="Busy"
            IsChecked="True"
            Content="显示不确定进度"
            Margin="0,0,0,12" />
        <ProgressBar>
            <ProgressBar.Style>
                <Style
                    TargetType="ProgressBar"
                    BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition
                                    Binding="{Binding IsChecked, ElementName=Busy}"
                                    Value="True" />
                                <Condition
                                    Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}"
                                    Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter
                                Property="IsIndeterminate"
                                Value="True" />
                        </MultiDataTrigger>
                        <DataTrigger
                            Binding="{Binding IsChecked, ElementName=Busy}"
                            Value="False">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
    </StackPanel>
</UserControl>