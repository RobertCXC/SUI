<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sui="clr-namespace:SUI;assembly=SUI"
    x:Class="SuiExamples.TextInputs"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.Label"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
                Width="24" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock
                Text="占位提示（PlaceholderText）"
                Style="{StaticResource Example.Label}" />
            <TextBox
                sui:TextBoxAssist.PlaceholderText="输入设备名称、序列号或关键词..."
                Margin="0,0,0,16"
                AutomationProperties.Name="占位提示输入框" />
            <TextBlock
                Text="访问密码（支持占位提示）"
                Style="{StaticResource Example.Label}" />
            <PasswordBox
                sui:TextBoxAssist.PlaceholderText="输入访问密钥"
                Margin="0,0,0,16"
                AutomationProperties.Name="示例访问密码" />
            <TextBlock
                Text="只读标识"
                Style="{StaticResource Example.Label}" />
            <TextBox
                IsReadOnly="True"
                Text="workspace / sui-gallery"
                Margin="0,0,0,16"
                AutomationProperties.Name="只读标识" />
            <TextBlock
                Text="紧凑参数输入（Height 28，适合高密度参数网格）"
                Style="{StaticResource Example.Label}" />
            <WrapPanel>
                <TextBox
                    Width="120"
                    Margin="0,0,8,8"
                    Style="{StaticResource SUI.TextBox.Compact}"
                    sui:TextBoxAssist.PlaceholderText="寄存器地址"
                    AutomationProperties.Name="紧凑文本框" />
                <ComboBox
                    Width="112"
                    Margin="0,0,8,8"
                    Style="{StaticResource SUI.ComboBox.Compact}"
                    SelectedIndex="0"
                    AutomationProperties.Name="紧凑下拉框">
                    <ComboBoxItem Content="115200 bps" />
                    <ComboBoxItem Content="9600 bps" />
                </ComboBox>
                <sui:SUINumberBox
                    Width="96"
                    Margin="0,0,8,8"
                    Style="{StaticResource SUI.NumberBox.Compact}"
                    Minimum="1"
                    Maximum="65535"
                    Value="500"
                    AutomationProperties.Name="紧凑数值框" />
                <DatePicker
                    Width="136"
                    Margin="0,0,8,8"
                    Style="{StaticResource SUI.DatePicker.Compact}"
                    sui:TextBoxAssist.PlaceholderText="紧凑日期"
                    AutomationProperties.Name="紧凑日期框" />
                <sui:TimePicker
                    Width="116"
                    Margin="0,0,8,8"
                    Style="{StaticResource SUI.TimePicker.Compact}"
                    PlaceholderText="紧凑时间"
                    AutomationProperties.Name="紧凑时间框" />
                <sui:SUIDateTimePicker
                    Width="188"
                    Margin="0,0,8,8"
                    Style="{StaticResource SUI.DateTimePicker.Compact}"
                    PlaceholderText="紧凑日期时间"
                    AutomationProperties.Name="紧凑日期时间框" />
                <Button
                    Margin="0,0,0,8"
                    Content="写入"
                    Style="{StaticResource SUI.Button.Primary.Compact}" />
            </WrapPanel>
        </StackPanel>
        <StackPanel
            Grid.Column="2">
            <TextBlock
                Text="项目描述 / 支持多行"
                Style="{StaticResource Example.Label}" />
            <TextBox
                Height="120"
                Text="用小而可靠的组件，&#xA;做出好看、顺手的桌面体验。&#xA;&#xA;在这里继续输入，试试中文与文本选择。"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,16"
                AutomationProperties.Name="项目描述" />
            <TextBlock
                Text="不可编辑"
                Style="{StaticResource Example.Label}" />
            <TextBox
                Text="此字段暂不可用"
                IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
