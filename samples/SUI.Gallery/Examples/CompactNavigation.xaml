<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:nav="clr-namespace:SUI.Navigation;assembly=SUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.CompactNavigation"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Eyebrow"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.Accent}" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
        <Style
            x:Key="Example.PageTitle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="30" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.Text}" />
        </Style>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.PageSubtitle"
            TargetType="TextBlock"
            BasedOn="{StaticResource Example.Muted}">
            <Setter
                Property="Margin"
                Value="0,10,0,28" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="LineHeight"
                Value="23" />
        </Style>
    </UserControl.Resources>
    <Border
        BorderBrush="{StaticResource SUI.Brush.Border}"
        BorderThickness="1"
        CornerRadius="8">
        <nav:SUINavigationView
            x:Name="CompactNav"
            PaneWidth="64"
            Height="290"
            SelectionChanged="OnCompactSelection">
            <StackPanel
                Margin="28"
                VerticalAlignment="Center">
                <TextBlock
                    Text="PREVIEW / 页面内容"
                    Style="{StaticResource Example.Eyebrow}" />
                <TextBlock
                    x:Name="CompactTitle"
                    Style="{StaticResource Example.PageTitle}" />
                <TextBlock
                    x:Name="CompactDescription"
                    Style="{StaticResource Example.PageSubtitle}" />
                <TextBlock
                    Text="点击左侧入口，体验内容切换与清晰的选中反馈。"
                    TextWrapping="Wrap"
                    Style="{StaticResource Example.Muted}" />
            </StackPanel>
        </nav:SUINavigationView>
    </Border>
</UserControl>