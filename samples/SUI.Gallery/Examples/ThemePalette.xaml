<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SuiExamples.ThemePalette"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    Foreground="{StaticResource SUI.Brush.Text}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style
            x:Key="Example.Muted"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{StaticResource SUI.Brush.TextSecondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource SUI.Font.Size.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
        </Style>
        <Style
            x:Key="Example.SectionCard"
            TargetType="Border">
            <Setter
                Property="Margin"
                Value="0,0,0,20" />
            <Setter
                Property="Padding"
                Value="24" />
            <Setter
                Property="Background"
                Value="{StaticResource SUI.Brush.Surface}" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource SUI.Brush.Border}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="{StaticResource SUI.Radius.Panel}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl
            x:Name="Palette"
            Margin="0,0,-12,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Style="{StaticResource Example.SectionCard}"
                        Padding="12"
                        Margin="0,0,12,12">
                        <StackPanel>
                            <Border
                                Height="48"
                                Background="{Binding Brush}"
                                BorderBrush="{StaticResource SUI.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,0,10" />
                            <TextBlock
                                Text="{Binding Role}"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="{Binding Hex}"
                                Style="{StaticResource Example.Muted}"
                                FontFamily="{StaticResource SUI.Font.Mono}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>