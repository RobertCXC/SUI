<Window
    x:Class="SUI.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="clr-namespace:SUI.Navigation;assembly=SUI"
    Title="SUI Gallery · Small UI. Sharp Experience."
    Width="1180"
    Height="800"
    MinWidth="1000"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource SUI.Brush.Background}"
    Foreground="{StaticResource SUI.Brush.Text}"
    FontFamily="{StaticResource SUI.Font.Family}"
    FontSize="{StaticResource SUI.Font.Size.Body}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="76" />
            <RowDefinition />
            <RowDefinition
                Height="36" />
        </Grid.RowDefinitions>
        <Border
            Background="{StaticResource SUI.Brush.Surface}"
            BorderBrush="{StaticResource SUI.Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid
                Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="230" />
                    <ColumnDefinition />
                    <ColumnDefinition
                        Width="310" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Border
                        Background="{StaticResource SUI.Brush.Accent}"
                        CornerRadius="8"
                        Width="38"
                        Height="38">
                        <TextBlock
                            Text="S"
                            FontWeight="Bold"
                            FontSize="23"
                            Foreground="{StaticResource SUI.Brush.TextOnAccent}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel
                        Margin="12,0,0,0">
                        <TextBlock
                            Text="SUI Gallery"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Small UI. Sharp Experience."
                            Style="{StaticResource Gallery.Muted}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="设计细节，亲手体验。"
                    VerticalAlignment="Center"
                    Style="{StaticResource Gallery.Muted}" />
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="查找控件 / Ctrl+K"
                        Style="{StaticResource Gallery.Label}"
                        Margin="0,0,0,4" />
                    <TextBox
                        x:Name="Search"
                        TextChanged="OnSearchChanged"
                        AutomationProperties.Name="查找控件"
                        ToolTip="支持中文、控件名称和样式名称，如 Button、开关、DataGrid" />
                </StackPanel>
            </Grid>
        </Border>
        <nav:SUINavigationView
            Grid.Row="1"
            x:Name="Navigation"
            PaneWidth="216"
            ItemHeight="52"
            SelectionChanged="OnNavigationSelectionChanged">
            <nav:SUINavigationView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="32" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding IconGlyph}"
                            FontFamily="{StaticResource SUI.Font.Icon}"
                            FontSize="18"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Title}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </nav:SUINavigationView.ItemTemplate>
            <Grid>
                <ContentControl
                    x:Name="PageHost"
                    Focusable="False"
                    Button.Click="OnPageAction" />
                <Border
                    x:Name="SearchEmpty"
                    Visibility="Collapsed"
                    Background="{StaticResource SUI.Brush.Background}"
                    Padding="32">
                    <StackPanel>
                        <TextBlock
                            Text="没有找到匹配的控件"
                            Style="{StaticResource Gallery.SectionTitle}" />
                        <TextBlock
                            Text="试试 Button、输入、导航或主题；清空搜索可返回全部分类。"
                            Style="{StaticResource Gallery.Muted}" />
                    </StackPanel>
                </Border>
            </Grid>
        </nav:SUINavigationView>
        <Border
            Grid.Row="2"
            Background="{StaticResource SUI.Brush.Surface}"
            BorderBrush="{StaticResource SUI.Brush.Border}"
            BorderThickness="0,1,0,0">
            <DockPanel
                Margin="24,0">
                <TextBlock
                    DockPanel.Dock="Right"
                    Text="WPF     ·     Tab 切换焦点，Space 操作"
                    VerticalAlignment="Center"
                    Style="{StaticResource Gallery.Muted}" />
                <TextBlock
                    x:Name="Status"
                    Text="就绪 · 所有示例均使用真实 SUI 控件"
                    VerticalAlignment="Center"
                    Style="{StaticResource Gallery.Muted}"
                    AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
