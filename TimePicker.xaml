<UserControl
    x:Class="SUI.TimePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    d:DesignHeight="32"
    d:DesignWidth="160"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
                <ResourceDictionary Source="/SUI;component/Styles/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SUI.TimePicker.ColumnListStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Width" Value="{StaticResource SUI.Control.TimeColumnWidth}" />
                <Setter Property="Height" Value="{StaticResource SUI.Control.TimeListHeight}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Height" Value="{StaticResource SUI.Control.Height.Compact}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="ItemChrome"
                                                Margin="2,1"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource SUI.Radius.Control}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SUI.Brush.Selected}" />
                                                <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Accent}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SUI.TimePicker.ToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Width" Value="{StaticResource SUI.Control.PickerButtonWidth}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Chrome"
                                    Margin="2"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource SUI.Radius.Control}"
                                    SnapsToDevicePixels="True">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource SUI.Font.Icon}"
                                           FontSize="{StaticResource SUI.Font.Size.Body}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="&#xE823;" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                                    <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsPressed" Value="True" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
            <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        </Style>
    </UserControl.Style>

    <Border x:Name="OuterBorder"
            BorderThickness="{StaticResource SUI.Border.Thickness}"
            CornerRadius="{StaticResource SUI.Radius.Control}"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.BorderHover}" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SUI.Brush.SurfaceAlt}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PlaceholderBlock"
                       Grid.Column="0"
                       Margin="{StaticResource SUI.Space.TextBox.Padding}"
                       Padding="{StaticResource SUI.Space.PlaceholderInset}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SUI.Brush.TextDisabled}"
                       IsHitTestVisible="False"
                       Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />

            <TextBox x:Name="PART_TextBox"
                     Grid.Column="0"
                     Style="{x:Null}"
                     MinHeight="0"
                     Padding="{StaticResource SUI.Space.TextBox.Padding}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Center"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     SelectionBrush="{StaticResource SUI.Brush.Accent}"
                     SelectionOpacity="0.3"
                     AutomationProperties.Name="时间输入">
                <TextBox.Template>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <ToggleButton x:Name="PART_ToggleButton"
                          Grid.Column="1"
                          AutomationProperties.Name="选择时间"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource SUI.TimePicker.ToggleButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen, ElementName=PART_Popup}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <Border x:Name="FocusBottom"
                    Grid.ColumnSpan="2"
                    Height="2"
                    Margin="{StaticResource SUI.Border.Thickness}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource SUI.Brush.Accent}"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   HorizontalOffset="-8"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=OuterBorder}"
                   StaysOpen="False"
                   VerticalOffset="4">
                <Border Margin="8,0,8,12"
                        Padding="{StaticResource SUI.Space.CalendarPadding}"
                        Background="{StaticResource SUI.Brush.Surface}"
                        BorderBrush="{StaticResource SUI.Brush.Border}"
                        BorderThickness="{StaticResource SUI.Border.Thickness}"
                        CornerRadius="{StaticResource SUI.Radius.Panel}"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.14" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource SUI.Font.Size.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                           Text="时" />
                                <ListBox x:Name="HourList"
                                         SelectionChanged="OnTimePartSelectionChanged"
                                         Style="{StaticResource SUI.TimePicker.ColumnListStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource SUI.Font.Size.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                           Text="分" />
                                <ListBox x:Name="MinuteList"
                                         SelectionChanged="OnTimePartSelectionChanged"
                                         Style="{StaticResource SUI.TimePicker.ColumnListStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="SecondColumn" Grid.Column="2" Margin="4,0,0,0" Visibility="Collapsed">
                                <TextBlock Margin="0,0,0,4"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource SUI.Font.Size.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                           Text="秒" />
                                <ListBox x:Name="SecondList"
                                         SelectionChanged="OnTimePartSelectionChanged"
                                         Style="{StaticResource SUI.TimePicker.ColumnListStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="{StaticResource SUI.Border.StrokeThickness}"
                                Margin="0,8,0,8"
                                Background="{StaticResource SUI.Brush.Border}" />

                        <DockPanel LastChildFill="False">
                            <Button Click="OnNowClick"
                                    Content="此刻"
                                    DockPanel.Dock="Left"
                                    MinHeight="{StaticResource SUI.Control.Height.Compact}"
                                    Padding="8,0"
                                    Margin="0,0,4,0" />
                            <Button Click="OnClearClick"
                                    Content="清除"
                                    DockPanel.Dock="Left"
                                    MinHeight="{StaticResource SUI.Control.Height.Compact}"
                                    Padding="8,0" />
                            <Button Click="OnConfirmClick"
                                    Content="确定"
                                    DockPanel.Dock="Right"
                                    MinHeight="{StaticResource SUI.Control.Height.Compact}"
                                    Padding="10,0"
                                    Style="{StaticResource SUI.Button.Primary}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
