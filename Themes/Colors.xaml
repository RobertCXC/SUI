<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    mc:Ignorable="po">

    <!-- SUI 唯一的颜色与规范数值文件：控件样式里不允许出现颜色字面量。 -->

    <!-- 强调色 -->
    <SolidColorBrush x:Key="SUI.Brush.Accent" po:Freeze="True" Color="#0F6CBD" />
    <SolidColorBrush x:Key="SUI.Brush.AccentHover" po:Freeze="True" Color="#115EA3" />
    <SolidColorBrush x:Key="SUI.Brush.AccentPressed" po:Freeze="True" Color="#0C3B5E" />
    <SolidColorBrush x:Key="SUI.Brush.TextOnAccent" po:Freeze="True" Color="#FFFFFF" />

    <!-- 表面 -->
    <SolidColorBrush x:Key="SUI.Brush.Background" po:Freeze="True" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SUI.Brush.Surface" po:Freeze="True" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SUI.Brush.SurfaceAlt" po:Freeze="True" Color="#FAFAFA" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="SUI.Brush.Text" po:Freeze="True" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SUI.Brush.TextSecondary" po:Freeze="True" Color="#616161" />
    <SolidColorBrush x:Key="SUI.Brush.TextDisabled" po:Freeze="True" Color="#A6A6A6" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="SUI.Brush.Border" po:Freeze="True" Color="#D1D1D1" />
    <SolidColorBrush x:Key="SUI.Brush.BorderHover" po:Freeze="True" Color="#B3B3B3" />
    <SolidColorBrush x:Key="SUI.Brush.Focus" po:Freeze="True" Color="#0F6CBD" />

    <!-- 交互状态底色 -->
    <SolidColorBrush x:Key="SUI.Brush.Hover" po:Freeze="True" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SUI.Brush.Pressed" po:Freeze="True" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SUI.Brush.Selected" po:Freeze="True" Color="#E5F1FB" />
    <SolidColorBrush x:Key="SUI.Brush.Disabled" po:Freeze="True" Color="#F5F5F5" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="SUI.Brush.Success" po:Freeze="True" Color="#107C10" />
    <SolidColorBrush x:Key="SUI.Brush.Warning" po:Freeze="True" Color="#BC4B09" />
    <SolidColorBrush x:Key="SUI.Brush.Danger" po:Freeze="True" Color="#C50F1F" />
    <SolidColorBrush x:Key="SUI.Brush.DangerHover" po:Freeze="True" Color="#A4262C" />
    <SolidColorBrush x:Key="SUI.Brush.DangerPressed" po:Freeze="True" Color="#751D24" />
    <SolidColorBrush x:Key="SUI.Brush.Info" po:Freeze="True" Color="#0F6CBD" />

    <!-- 字体 -->
    <FontFamily x:Key="SUI.Font.Family">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="SUI.Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="SUI.Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="SUI.Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="SUI.Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="SUI.Font.Size.Title">16</sys:Double>

    <!-- 圆角 -->
    <CornerRadius x:Key="SUI.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="SUI.Radius.Panel">8</CornerRadius>
    <CornerRadius x:Key="SUI.Radius.ScrollBarThumb">3</CornerRadius>

    <!-- 边框与尺寸 -->
    <Thickness x:Key="SUI.Border.Thickness">1</Thickness>
    <sys:Double x:Key="SUI.Control.Height">32</sys:Double>
    <sys:Double x:Key="SUI.Control.ScrollBarSize">10</sys:Double>
    <Thickness x:Key="SUI.Space.ButtonPadding">12,0</Thickness>
    <Thickness x:Key="SUI.Space.TextBox.Padding">10,0</Thickness>
    <Thickness x:Key="SUI.Space.TextBox.Padding.Multiline">10,6</Thickness>
    <Thickness x:Key="SUI.Space.ComboBoxPopupPadding">4</Thickness>
    <Thickness x:Key="SUI.Space.CheckRadioContent">8,0,0,0</Thickness>
    <sys:Double x:Key="SUI.Control.CheckRadioSize">18</sys:Double>
    <sys:Double x:Key="SUI.Border.StrokeThickness">1</sys:Double>
    <Thickness x:Key="SUI.Space.TabPadding">12,0</Thickness>
    <sys:Double x:Key="SUI.Control.TabHeight">36</sys:Double>
    <sys:Double x:Key="SUI.Control.TabIndicatorThickness">2</sys:Double>
    <Thickness x:Key="SUI.Space.ListBoxItemPadding">10,0</Thickness>
    <Thickness x:Key="SUI.Space.ListBoxItemMargin">2</Thickness>
    <Thickness x:Key="SUI.Space.MenuPanelPadding">4</Thickness>
    <Thickness x:Key="SUI.Space.MenuItemPadding">8,0</Thickness>
    <Thickness x:Key="SUI.Space.MenuGestureMargin">12,0,8,0</Thickness>
    <Thickness x:Key="SUI.Space.MenuArrowMargin">8,0,2,0</Thickness>
    <Thickness x:Key="SUI.Space.MenuSeparatorMargin">0,4</Thickness>
    <Thickness x:Key="SUI.Space.ToolTipPadding">8,4</Thickness>
    <Thickness x:Key="SUI.Space.DataGridHeaderPadding">10,8</Thickness>
    <Thickness x:Key="SUI.Space.DataGridCellPadding">10,5</Thickness>
    <Thickness x:Key="SUI.Space.DataGridSortArrowMargin">4,0,4,0</Thickness>
    <Thickness x:Key="SUI.Border.FocusThickness">2</Thickness>
    <sys:Double x:Key="SUI.Control.MenuIconColumnWidth">20</sys:Double>
    <CornerRadius x:Key="SUI.Radius.ProgressBar">2</CornerRadius>
    <sys:Double x:Key="SUI.Control.ProgressBarHeight">4</sys:Double>
    <CornerRadius x:Key="SUI.Radius.SwitchTrack">10</CornerRadius>
    <sys:Double x:Key="SUI.Control.SwitchWidth">40</sys:Double>
    <sys:Double x:Key="SUI.Control.SwitchHeight">20</sys:Double>
    <sys:Double x:Key="SUI.Control.SwitchKnobSize">12</sys:Double>
    <sys:Double x:Key="SUI.Control.SwitchPressedKnobSize">14</sys:Double>
    <sys:Double x:Key="SUI.Control.SwitchKnobTravel">22</sys:Double>
    <Thickness x:Key="SUI.Space.SwitchKnobMargin">3,0</Thickness>
    <Thickness x:Key="SUI.Space.SwitchContentGap">8,0,0,0</Thickness>

    <!-- 间距 -->
    <sys:Double x:Key="SUI.Space.1">4</sys:Double>
    <sys:Double x:Key="SUI.Space.2">8</sys:Double>
    <sys:Double x:Key="SUI.Space.3">12</sys:Double>
    <sys:Double x:Key="SUI.Space.4">16</sys:Double>

    <!-- 徽标浅色背景，与对应语义文字配对。 -->
    <SolidColorBrush x:Key="SUI.Brush.SuccessSubtle" po:Freeze="True" Color="#EDF7ED" />
    <SolidColorBrush x:Key="SUI.Brush.WarningSubtle" po:Freeze="True" Color="#FFF4E5" />
    <SolidColorBrush x:Key="SUI.Brush.DangerSubtle" po:Freeze="True" Color="#FDE7E9" />
</ResourceDictionary>
