<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SUI.NumberStepperButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Delay" Value="380" />
        <Setter Property="Interval" Value="60" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SUINumberBox}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource SUI.Border.Thickness}" />
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.TextBox.Padding}" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SUINumberBox}">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     MinHeight="0"
                                     Padding="{TemplateBinding Padding}"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     SelectionBrush="{StaticResource SUI.Brush.Accent}"
                                     SelectionOpacity="0.3"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     IsEnabled="{TemplateBinding IsEnabled}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <TextBlock x:Name="Placeholder"
                                       Grid.Column="0"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{StaticResource SUI.Brush.TextDisabled}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Visibility="Collapsed" />

                            <Border x:Name="StepperPanel"
                                    Grid.Column="1"
                                    Margin="0,2,2,2"
                                    BorderBrush="{StaticResource SUI.Brush.Border}"
                                    BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton x:Name="PART_UpButton"
                                                  Grid.Row="0"
                                                  AutomationProperties.Name="增加数值"
                                                  Style="{StaticResource SUI.NumberStepperButtonStyle}">
                                        <Path Width="7" Height="4"
                                              Data="M 0,4 L 3.5,0 L 7,4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                    </RepeatButton>
                                    <RepeatButton x:Name="PART_DownButton"
                                                  Grid.Row="1"
                                                  AutomationProperties.Name="减少数值"
                                                  Style="{StaticResource SUI.NumberStepperButtonStyle}">
                                        <Path Width="7" Height="4"
                                              Data="M 0,0 L 3.5,4 L 7,0"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                    </RepeatButton>
                                </Grid>
                            </Border>

                            <Border x:Name="FocusBottomBorder"
                                    Grid.ColumnSpan="2"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource SUI.Brush.Accent}"
                                    CornerRadius="0,0,3,3"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowButtons" Value="False">
                            <Setter TargetName="StepperPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="PART_TextBox" Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.BorderHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusBottomBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource SUI.Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
