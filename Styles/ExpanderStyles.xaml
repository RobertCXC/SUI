<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SUI.Expander.HeaderToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.ExpanderHeaderMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.ExpanderHeaderPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HeaderChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource SUI.Radius.PanelInner}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border Grid.Column="1"
                                        Width="{StaticResource SUI.Control.ExpanderChevronSize}"
                                        Height="{StaticResource SUI.Control.ExpanderChevronSize}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent">
                                    <Path x:Name="ChevronPath"
                                          Width="8"
                                          Height="4"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0,0 L 4,4 L 8,0"
                                          Fill="Transparent"
                                          RenderTransformOrigin="0.5,0.5"
                                          Stretch="Fill"
                                          Stroke="{StaticResource SUI.Brush.TextSecondary}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusOutline"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource SUI.Border.FocusThickness}"
                                CornerRadius="{StaticResource SUI.Radius.PanelInner}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Down" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Down}" />
                            <Setter TargetName="FocusOutline" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Down}" />
                            <Setter TargetName="ChevronPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Up" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ChevronPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Up" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Up}" />
                            <Setter TargetName="FocusOutline" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Up}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Left" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ChevronPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Left" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Left}" />
                            <Setter TargetName="FocusOutline" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Left}" />
                            <Setter TargetName="ChevronPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Right" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ChevronPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Right" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Right}" />
                            <Setter TargetName="FocusOutline" Property="CornerRadius" Value="{StaticResource SUI.Radius.ExpanderHeader.Right}" />
                            <Setter TargetName="ChevronPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                            <Setter TargetName="ChevronPath" Property="Stroke" Value="{StaticResource SUI.Brush.Text}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="ChevronPath" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SUI.Expander.PlainHeaderToggleStyle"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource SUI.Expander.HeaderToggleStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.ExpanderPlainHeaderPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HeaderChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource SUI.Radius.Control}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border Grid.Column="1"
                                        Width="{StaticResource SUI.Control.ExpanderChevronSize}"
                                        Height="{StaticResource SUI.Control.ExpanderChevronSize}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent">
                                    <Path x:Name="ChevronPath"
                                          Width="8"
                                          Height="4"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0,0 L 4,4 L 8,0"
                                          Fill="Transparent"
                                          RenderTransformOrigin="0.5,0.5"
                                          Stretch="Fill"
                                          Stroke="{StaticResource SUI.Brush.TextSecondary}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
