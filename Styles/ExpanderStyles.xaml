                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                        </Trigger>
