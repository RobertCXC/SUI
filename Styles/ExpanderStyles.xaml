    <Style TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource SUI.Border.Thickness}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.CardPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SUI.Radius.Panel}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource SUI.Expander.HeaderToggleStyle}" />
                            <Border x:Name="HeaderDivider"
                                    DockPanel.Dock="Top"
                                    Height="{StaticResource SUI.Border.StrokeThickness}"
                                    Background="{StaticResource SUI.Brush.Border}"
                                    Visibility="Collapsed" />
                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="HeaderDivider" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="HeaderDivider" Property="DockPanel.Dock" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="HeaderDivider" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="HeaderDivider" Property="Height" Value="Auto" />
                            <Setter TargetName="HeaderDivider" Property="Width" Value="{StaticResource SUI.Border.StrokeThickness}" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="HeaderDivider" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="HeaderDivider" Property="Height" Value="Auto" />
                            <Setter TargetName="HeaderDivider" Property="Width" Value="{StaticResource SUI.Border.StrokeThickness}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 轻量嵌套折叠容器：透明底无外框，适合放在 GroupBox 或 SUI.Border.Card 内部。 -->
    <Style x:Key="SUI.Expander.Plain"
           TargetType="{x:Type Expander}"
           BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,8,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource SUI.Expander.PlainHeaderToggleStyle}" />
                            <Border x:Name="HeaderDivider"
                                    DockPanel.Dock="Top"
                                    Height="{StaticResource SUI.Border.StrokeThickness}"
                                    Margin="6,2,6,0"
                                    Background="{StaticResource SUI.Brush.Border}"
                                    Visibility="Collapsed" />
                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="HeaderDivider" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="HeaderDivider" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="HeaderDivider" Property="Margin" Value="6,0,6,2" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="HeaderDivider" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="HeaderDivider" Property="Height" Value="Auto" />
                            <Setter TargetName="HeaderDivider" Property="Width" Value="{StaticResource SUI.Border.StrokeThickness}" />
                            <Setter TargetName="HeaderDivider" Property="Margin" Value="0,6,2,6" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="HeaderDivider" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="HeaderDivider" Property="Height" Value="Auto" />
                            <Setter TargetName="HeaderDivider" Property="Width" Value="{StaticResource SUI.Border.StrokeThickness}" />
                            <Setter TargetName="HeaderDivider" Property="Margin" Value="2,6,0,6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
