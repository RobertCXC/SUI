<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
        <ResourceDictionary Source="/SUI;component/Styles/ButtonStyles.xaml" />
        <ResourceDictionary Source="/SUI;component/Styles/DatePickerStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="SUI.DateTimePicker.EmptyValidationTemplate">
        <AdornedElementPlaceholder />
    </ControlTemplate>

    <Style x:Key="SUI.DateTimePicker.ColumnListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="{StaticResource SUI.Control.TimeListHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Height" Value="{StaticResource SUI.Control.Height.Compact}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="ItemChrome"
                                        Margin="2,1"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource SUI.Radius.Control}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SUI.Brush.Selected}" />
                                        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Accent}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SUI.DateTimePicker.ToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="{StaticResource SUI.Control.PickerButtonWidth}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome"
                            Margin="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SUI.Font.Icon}"
                                   FontSize="{StaticResource SUI.Font.Size.Body}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="&#xE787;" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SUIDateTimePicker}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource SUI.Border.Thickness}" />
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.TextBox.Padding}" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource SUI.DateTimePicker.EmptyValidationTemplate}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SUIDateTimePicker}">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Placeholder"
                                       Grid.Column="0"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="{StaticResource SUI.Space.PlaceholderInset}"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{StaticResource SUI.Brush.TextDisabled}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding PlaceholderText}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />

                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     MinHeight="0"
                                     Padding="{TemplateBinding Padding}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     IsEnabled="{TemplateBinding IsEnabled}"
                                     SelectionBrush="{StaticResource SUI.Brush.Accent}"
                                     SelectionOpacity="0.3"
                                     AutomationProperties.Name="日期时间输入">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <ToggleButton x:Name="PART_ToggleButton"
                                          Grid.Column="1"
                                          AutomationProperties.Name="选择日期时间"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource SUI.DateTimePicker.ToggleButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen, ElementName=PART_Popup}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MinHeight, RelativeSource={RelativeSource TemplatedParent}}" Value="{StaticResource SUI.Control.Height.Compact}">
                                                <Setter Property="Width" Value="{StaticResource SUI.Control.PickerButtonWidth.Compact}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Border x:Name="FocusBottom"
                                    Grid.ColumnSpan="2"
                                    Height="2"
                                    Margin="{StaticResource SUI.Border.Thickness}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource SUI.Brush.Accent}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   HorizontalOffset="-8"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=OuterBorder}"
                                   StaysOpen="False"
                                   VerticalOffset="4">
                                <Border Margin="8,0,8,12"
                                        Padding="{StaticResource SUI.Space.CalendarPadding}"
                                        Background="{StaticResource SUI.Brush.Surface}"
                                        BorderBrush="{StaticResource SUI.Brush.Border}"
                                        BorderThickness="{StaticResource SUI.Border.Thickness}"
                                        CornerRadius="{StaticResource SUI.Radius.Panel}"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.14" ShadowDepth="2" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Calendar x:Name="PART_Calendar"
                                                      Grid.Column="0"
                                                      VerticalAlignment="Top"
                                                      Background="Transparent"
                                                      BorderThickness="0" />

                                            <Border Grid.Column="1"
                                                    Width="{StaticResource SUI.Border.StrokeThickness}"
                                                    Margin="6,4,8,4"
                                                    Background="{StaticResource SUI.Brush.Border}" />

                                            <Grid Grid.Column="2" VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Margin="0,2,0,4"
                                                               HorizontalAlignment="Center"
                                                               FontSize="{StaticResource SUI.Font.Size.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                                               Text="时" />
                                                    <ListBox x:Name="PART_HourList"
                                                             Style="{StaticResource SUI.DateTimePicker.ColumnListStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Margin="0,2,0,4"
                                                               HorizontalAlignment="Center"
                                                               FontSize="{StaticResource SUI.Font.Size.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                                               Text="分" />
                                                    <ListBox x:Name="PART_MinuteList"
                                                             Style="{StaticResource SUI.DateTimePicker.ColumnListStyle}" />
                                                </StackPanel>

                                                <StackPanel x:Name="SecondColumn" Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Margin="0,2,0,4"
                                                               HorizontalAlignment="Center"
                                                               FontSize="{StaticResource SUI.Font.Size.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                                               Text="秒" />
                                                    <ListBox x:Name="PART_SecondList"
                                                             Style="{StaticResource SUI.DateTimePicker.ColumnListStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <Border Height="{StaticResource SUI.Border.StrokeThickness}"
                                                Margin="0,8,0,8"
                                                Background="{StaticResource SUI.Brush.Border}" />

                                        <DockPanel LastChildFill="False">
                                            <Button x:Name="PART_NowButton"
                                                    Content="此刻"
                                                    DockPanel.Dock="Left"
                                                    Margin="0,0,4,0"
                                                    Style="{StaticResource SUI.Button.Compact}" />
                                            <Button x:Name="PART_TodayButton"
                                                    Content="今天"
                                                    DockPanel.Dock="Left"
                                                    Margin="0,0,4,0"
                                                    Style="{StaticResource SUI.Button.Compact}" />
                                            <Button x:Name="PART_ClearButton"
                                                    Content="清除"
                                                    DockPanel.Dock="Left"
                                                    Style="{StaticResource SUI.Button.Compact}" />
                                            <Button x:Name="PART_ConfirmButton"
                                                    Content="确定"
                                                    DockPanel.Dock="Right"
                                                    Padding="12,0"
                                                    Style="{StaticResource SUI.Button.Primary.Compact}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_TextBox" Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowSeconds" Value="False">
                            <Setter TargetName="SecondColumn" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="AllowClear" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.BorderHover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusBottom" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusBottom" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource SUI.Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Danger}" />
                            <Setter TargetName="FocusBottom" Property="Background" Value="{StaticResource SUI.Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                            <Setter TargetName="FocusBottom" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding Path=(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 紧凑日期时间选择：高度 28，与 SUI.TextBox.Compact / SUI.ComboBox.Compact 对齐。 -->
    <Style x:Key="SUI.DateTimePicker.Compact"
           TargetType="{x:Type local:SUIDateTimePicker}"
           BasedOn="{StaticResource {x:Type local:SUIDateTimePicker}}">
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height.Compact}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.TextBox.Padding.Compact}" />
    </Style>
</ResourceDictionary>
