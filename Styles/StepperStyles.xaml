<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:SUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="SUI.StepperItem.HorizontalTemplate" TargetType="{x:Type local:SUIStepperItem}">
        <Border x:Name="ItemRoot"
                Padding="4,6"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{StaticResource SUI.Border.FocusThickness}"
                CornerRadius="{StaticResource SUI.Radius.Control}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部圆点与连接线 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LeftConnector"
                            Grid.Column="0"
                            Height="{StaticResource SUI.Control.StepperConnectorThickness}"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource SUI.Brush.Border}"
                            CornerRadius="1" />

                    <Border x:Name="StepBadge"
                            Grid.Column="1"
                            Width="{StaticResource SUI.Control.StepperBadgeSize}"
                            Height="{StaticResource SUI.Control.StepperBadgeSize}"
                            Background="{StaticResource SUI.Brush.Surface}"
                            BorderBrush="{StaticResource SUI.Brush.BorderHover}"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="NumberText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource SUI.Font.Size.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                       Text="{Binding StepNumber, RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="GlyphText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource SUI.Font.Icon}"
                                       FontSize="{StaticResource SUI.Font.Size.Body}"
                                       Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                       Text="{TemplateBinding IconGlyph}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path x:Name="CompletedMark"
                                  Width="11"
                                  Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,4.5 L 4,7.5 L 10,1.5"
                                  Fill="Transparent"
                                  Stroke="{StaticResource SUI.Brush.Accent}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75"
                                  Visibility="Collapsed" />
                            <Path x:Name="ErrorMark"
                                  Width="10"
                                  Height="10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 2,2 L 8,8 M 8,2 L 2,8"
                                  Fill="Transparent"
                                  Stroke="{StaticResource SUI.Brush.TextOnAccent}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border x:Name="RightConnector"
                            Grid.Column="2"
                            Height="{StaticResource SUI.Control.StepperConnectorThickness}"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource SUI.Brush.Border}"
                            CornerRadius="1" />
                </Grid>

                <!-- 标题与副标题 -->
                <StackPanel Grid.Row="1" Margin="4,8,4,0">
                    <TextBlock x:Name="TitleText"
                               HorizontalAlignment="Center"
                               FontWeight="Normal"
                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                               Text="{TemplateBinding Title}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource SUI.Font.Size.Caption}"
                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                               Text="{TemplateBinding Description}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ContentPresenter x:Name="CustomContent"
                                      Margin="0,4,0,0"
                                      HorizontalAlignment="Center"
                                      ContentSource="Content"
                                      Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsFirst" Value="True">
                <Setter TargetName="LeftConnector" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsLast" Value="True">
                <Setter TargetName="RightConnector" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="HasContent" Value="True">
                <Setter TargetName="CustomContent" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="">
                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Status" Value="Active">
                <Setter TargetName="LeftConnector" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="NumberText" Property="Foreground" Value="{StaticResource SUI.Brush.TextOnAccent}" />
                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource SUI.Brush.TextOnAccent}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="Status" Value="Completed">
                <Setter TargetName="LeftConnector" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="RightConnector" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Selected}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CompletedMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
            </Trigger>
            <Trigger Property="Status" Value="Error">
                <Setter TargetName="LeftConnector" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Danger}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Danger}" />
                <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ErrorMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.Danger}" />
                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Cursor" Value="Hand" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsKeyboardFocused" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                <Setter TargetName="NumberText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="CompletedMark" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="DescriptionText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SUI.StepperItem.VerticalTemplate" TargetType="{x:Type local:SUIStepperItem}">
        <Border x:Name="ItemRoot"
                Padding="6,4"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{StaticResource SUI.Border.FocusThickness}"
                CornerRadius="{StaticResource SUI.Radius.Control}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧圆点与垂直连接线 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="StepBadge"
                            Grid.Row="0"
                            Width="{StaticResource SUI.Control.StepperBadgeSize}"
                            Height="{StaticResource SUI.Control.StepperBadgeSize}"
                            Background="{StaticResource SUI.Brush.Surface}"
                            BorderBrush="{StaticResource SUI.Brush.BorderHover}"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="NumberText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource SUI.Font.Size.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                       Text="{Binding StepNumber, RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="GlyphText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource SUI.Font.Icon}"
                                       FontSize="{StaticResource SUI.Font.Size.Body}"
                                       Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                       Text="{TemplateBinding IconGlyph}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path x:Name="CompletedMark"
                                  Width="11"
                                  Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,4.5 L 4,7.5 L 10,1.5"
                                  Fill="Transparent"
                                  Stroke="{StaticResource SUI.Brush.Accent}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75"
                                  Visibility="Collapsed" />
                            <Path x:Name="ErrorMark"
                                  Width="10"
                                  Height="10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 2,2 L 8,8 M 8,2 L 2,8"
                                  Fill="Transparent"
                                  Stroke="{StaticResource SUI.Brush.TextOnAccent}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border x:Name="BottomConnector"
                            Grid.Row="1"
                            Width="{StaticResource SUI.Control.StepperConnectorThickness}"
                            MinHeight="18"
                            Margin="0,6,0,2"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SUI.Brush.Border}"
                            CornerRadius="1" />
                </Grid>

                <!-- 右侧标题与副标题 -->
                <StackPanel Grid.Column="1" Margin="12,3,0,14">
                    <TextBlock x:Name="TitleText"
                               FontWeight="Normal"
                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                               Text="{TemplateBinding Title}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText"
                               Margin="0,2,0,0"
                               FontSize="{StaticResource SUI.Font.Size.Caption}"
                               Foreground="{StaticResource SUI.Brush.TextSecondary}"
                               Text="{TemplateBinding Description}"
                               TextWrapping="Wrap" />
                    <ContentPresenter x:Name="CustomContent"
                                      Margin="0,4,0,0"
                                      ContentSource="Content"
                                      Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsLast" Value="True">
                <Setter TargetName="BottomConnector" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasContent" Value="True">
                <Setter TargetName="CustomContent" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="">
                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Status" Value="Active">
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="NumberText" Property="Foreground" Value="{StaticResource SUI.Brush.TextOnAccent}" />
                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource SUI.Brush.TextOnAccent}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="Status" Value="Completed">
                <Setter TargetName="BottomConnector" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Selected}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Accent}" />
                <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CompletedMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
            </Trigger>
            <Trigger Property="Status" Value="Error">
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Danger}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Danger}" />
                <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ErrorMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.Danger}" />
                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Cursor" Value="Hand" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsKeyboardFocused" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                <Setter TargetName="StepBadge" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                <Setter TargetName="NumberText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="CompletedMark" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                <Setter TargetName="DescriptionText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:SUIStepperItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource SUI.StepperItem.HorizontalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource SUI.StepperItem.VerticalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:SUIStepper}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <primitives:UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SUIStepper}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
