<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource SUI.Control.ProgressBarHeight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="PART_Track"
                          ClipToBounds="True"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SUI.Radius.ProgressBar}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource SUI.Radius.ProgressBar}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="PART_GlowRect"
                                CornerRadius="{StaticResource SUI.Radius.ProgressBar}"
                                Visibility="Collapsed"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <DrawingBrush Stretch="Fill" TileMode="None" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                                    <DrawingBrush.RelativeTransform>
                                        <TranslateTransform x:Name="IndeterminateTransform" X="0" />
                                    </DrawingBrush.RelativeTransform>
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="{StaticResource SUI.Brush.Accent}">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,0.3,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="FocusOutline"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource SUI.Border.FocusThickness}"
                                CornerRadius="{StaticResource SUI.Radius.ProgressBar}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsIndeterminate" Value="True" />
                                <Condition Property="Visibility" Value="Visible" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="0"
                                                         To="0.7"
                                                         Duration="0:0:0.75"
                                                         AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
