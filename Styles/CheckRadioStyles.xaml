<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.BorderHover}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="FocusBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="BoxSurface"
                                    Width="{StaticResource SUI.Control.CheckRadioSize}"
                                    Height="{StaticResource SUI.Control.CheckRadioSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{StaticResource SUI.Border.Thickness}"
                                    CornerRadius="{StaticResource SUI.Radius.Control}"
                                    SnapsToDevicePixels="True" />

                            <Path x:Name="CheckMark"
                                  Width="{StaticResource SUI.Space.3}"
                                  Height="{StaticResource SUI.Space.2}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,4 L 4,7 L 11,1"
                                  Fill="Transparent"
                                  Stroke="{StaticResource SUI.Brush.TextOnAccent}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.5"
                                  Visibility="Collapsed" />

                            <Path x:Name="IndeterminateMark"
                                  Width="{StaticResource SUI.Space.3}"
                                  Height="{StaticResource SUI.Space.2}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,4 L 11,4"
                                  Fill="Transparent"
                                  Stroke="{StaticResource SUI.Brush.TextOnAccent}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2"
                                  Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1"
                                              Margin="{StaticResource SUI.Space.CheckRadioContent}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Content"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxSurface" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                            <Setter TargetName="BoxSurface" Property="BorderBrush" Value="{StaticResource SUI.Brush.Accent}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="BoxSurface" Property="Background" Value="{StaticResource SUI.Brush.Accent}" />
                            <Setter TargetName="BoxSurface" Property="BorderBrush" Value="{StaticResource SUI.Brush.Accent}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BoxSurface" Property="BorderBrush" Value="{StaticResource SUI.Brush.TextSecondary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BoxSurface" Property="Background" Value="{StaticResource SUI.Brush.AccentPressed}" />
                            <Setter TargetName="BoxSurface" Property="BorderBrush" Value="{StaticResource SUI.Brush.AccentPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="BoxSurface" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="BoxSurface" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                            <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="IndeterminateMark" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.BorderHover}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="FocusBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="RadioSurface"
                                     Width="{StaticResource SUI.Control.CheckRadioSize}"
                                     Height="{StaticResource SUI.Control.CheckRadioSize}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{StaticResource SUI.Border.StrokeThickness}"
                                     SnapsToDevicePixels="True" />

                            <Ellipse x:Name="RadioDot"
                                     Width="{StaticResource SUI.Space.2}"
                                     Height="{StaticResource SUI.Space.2}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource SUI.Brush.TextOnAccent}"
                                     Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1"
                                              Margin="{StaticResource SUI.Space.CheckRadioContent}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Content"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioSurface" Property="Fill" Value="{StaticResource SUI.Brush.Accent}" />
                            <Setter TargetName="RadioSurface" Property="Stroke" Value="{StaticResource SUI.Brush.Accent}" />
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RadioSurface" Property="Stroke" Value="{StaticResource SUI.Brush.TextSecondary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RadioSurface" Property="Fill" Value="{StaticResource SUI.Brush.AccentPressed}" />
                            <Setter TargetName="RadioSurface" Property="Stroke" Value="{StaticResource SUI.Brush.AccentPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="RadioSurface" Property="Fill" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="RadioSurface" Property="Stroke" Value="{StaticResource SUI.Brush.Border}" />
                            <Setter TargetName="RadioDot" Property="Fill" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
