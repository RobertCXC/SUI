<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SwitchCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="0"
                            Width="35"
                            Height="18">
                            <!--  Hitbox  -->
                            <Rectangle Fill="Transparent" />
                            <!--  Toggle-Switch Outline  -->
                            <Border
                                x:Name="ToggleBorder"
                                BorderBrush="Black"
                                BorderThickness="1"
                                CornerRadius="7">
                                <!--  Dot in Toggle-Switch  -->
                                <Ellipse
                                    x:Name="ToggleEllipse"
                                    Width="12"
                                    Height="12"
                                    Margin="3,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="#595b5a" />
                            </Border>
                        </Grid>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Change colors and move dot to the right  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleEllipse" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#5B72C2" />
                            <Setter TargetName="ToggleBorder" Property="Background" Value="#1976c6" />
                            <Setter TargetName="ToggleEllipse" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="ToggleEllipse" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#5B72C2" />
                            <Setter TargetName="ToggleBorder" Property="Background" Value="#f2f7f7" />
                            <Setter TargetName="ToggleEllipse" Property="Fill" Value="#595b5a" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
</ResourceDictionary>