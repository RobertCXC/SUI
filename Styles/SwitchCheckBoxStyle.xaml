<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SwitchCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="MinHeight" Value="{StaticResource SUI.Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SwitchTrack"
                              Grid.Column="0"
                              Width="{StaticResource SUI.Control.SwitchWidth}"
                              Height="{StaticResource SUI.Control.SwitchHeight}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              SnapsToDevicePixels="True">
                            <Border x:Name="SwitchTrackBase"
                                    Background="{StaticResource SUI.Brush.Surface}"
                                    BorderBrush="{StaticResource SUI.Brush.BorderHover}"
                                    BorderThickness="{StaticResource SUI.Border.Thickness}"
                                    CornerRadius="{StaticResource SUI.Radius.SwitchTrack}" />
                            <Border x:Name="SwitchTrackFill"
                                    Background="{StaticResource SUI.Brush.Accent}"
                                    BorderBrush="{StaticResource SUI.Brush.Accent}"
                                    BorderThickness="{StaticResource SUI.Border.Thickness}"
                                    CornerRadius="{StaticResource SUI.Radius.SwitchTrack}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Grid x:Name="SwitchKnob"
                                  Width="{StaticResource SUI.Control.SwitchKnobSize}"
                                  Height="{StaticResource SUI.Control.SwitchKnobSize}"
                                  Margin="{StaticResource SUI.Space.SwitchKnobMargin}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="SwitchKnobScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="SwitchKnobTranslation" X="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="SwitchKnobBase"
                                         Fill="{StaticResource SUI.Brush.TextSecondary}" />
                                <Ellipse x:Name="SwitchKnobOn"
                                         Fill="{StaticResource SUI.Brush.TextOnAccent}"
                                         Opacity="0" />
                            </Grid>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{StaticResource SUI.Space.SwitchContentGap}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          ContentSource="Content"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobTranslation"
                                                         Storyboard.TargetProperty="X"
                                                         From="0"
                                                         To="{StaticResource SUI.Control.SwitchKnobTravel}"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SwitchTrackFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobTranslation"
                                                         Storyboard.TargetProperty="X"
                                                         From="{StaticResource SUI.Control.SwitchKnobTravel}"
                                                         To="0"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SwitchTrackFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrackBase" Property="BorderBrush" Value="{StaticResource SUI.Brush.TextSecondary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.12"
                                                         Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.12"
                                                         Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="SwitchTrackBase" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="SwitchTrackBase" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                            <Setter TargetName="SwitchTrackFill" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="SwitchTrackFill" Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
                            <Setter TargetName="SwitchKnobBase" Property="Fill" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="SwitchKnobOn" Property="Fill" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SUI.Switch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SwitchCheckBoxStyle}" />
</ResourceDictionary>
