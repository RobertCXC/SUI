<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 标签关闭按钮：不参与 Tab 焦点，键盘关闭使用标签头上的 Ctrl+F4。 -->
    <Style x:Key="SUI.Button.TabClose" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{StaticResource SUI.Control.TabCloseButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SUI.Control.TabCloseButtonSize}" />
        <Setter Property="Margin" Value="{StaticResource SUI.Space.TabCloseButtonMargin}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SUI.Font.Icon}"
                                   FontSize="{StaticResource SUI.Font.Size.IconSmall}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="&#xE711;" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏溢出时的左右滚动与“全部标签”按钮。 -->
    <Style x:Key="SUI.Button.TabStrip" TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="{StaticResource SUI.Control.TabScrollButtonWidth}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.IconSmall}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SUI.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SUI.Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SUI.TabControl.ScrollableTemplate" TargetType="{x:Type TabControl}">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="PART_HeaderScrollViewer"
                              local:TabControlAssist.IsHeaderScrollHost="True"
                              CanContentScroll="False"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                </ScrollViewer>
                <StackPanel x:Name="OverflowButtons"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <RepeatButton AutomationProperties.Name="向左滚动标签"
                                  Command="{x:Static ScrollBar.LineLeftCommand}"
                                  CommandTarget="{Binding ElementName=PART_HeaderScrollViewer}"
                                  Content="&#xE76B;"
                                  Style="{StaticResource SUI.Button.TabStrip}" />
                    <RepeatButton AutomationProperties.Name="向右滚动标签"
                                  Command="{x:Static ScrollBar.LineRightCommand}"
                                  CommandTarget="{Binding ElementName=PART_HeaderScrollViewer}"
                                  Content="&#xE76C;"
                                  Style="{StaticResource SUI.Button.TabStrip}" />
                    <Button AutomationProperties.Name="全部标签"
                            local:TabControlAssist.IsOverflowMenuButton="True"
                            Content="&#xE70D;"
                            Style="{StaticResource SUI.Button.TabStrip}"
                            ToolTip="全部标签" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1"
                    Height="{StaticResource SUI.Border.StrokeThickness}"
                    Background="{StaticResource SUI.Brush.Border}" />
            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Grid.Row="2"
                              Margin="{TemplateBinding Padding}"
                              ContentSource="SelectedContent"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="local:TabControlAssist.HasHeaderOverflow" Value="True">
                <Setter TargetName="OverflowButtons" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        <Border Grid.Row="1"
                                Height="{StaticResource SUI.Border.StrokeThickness}"
                                Background="{StaticResource SUI.Brush.Border}" />
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="2"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="SelectedContent"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="local:TabControlAssist.IsHeaderScrollable" Value="True">
                <Setter Property="Template" Value="{StaticResource SUI.TabControl.ScrollableTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
        <Setter Property="Height" Value="{StaticResource SUI.Control.TabHeight}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.TabPadding}" />
        <!-- WPF copies these values to PART_SelectedContentHost when selecting a page. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- 默认继承所属 TabControl 的 IsClosable；在 TabItem 上显式设置可覆盖。 -->
        <Setter Property="local:TabControlAssist.IsClosable" Value="{Binding Path=(local:TabControlAssist.IsClosable), RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <StackPanel Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <Button x:Name="PART_CloseButton"
                                    AutomationProperties.Name="关闭标签页"
                                    Command="{x:Static local:TabControlAssist.CloseTabCommand}"
                                    Style="{StaticResource SUI.Button.TabClose}"
                                    ToolTip="关闭 (Ctrl+F4)"
                                    Visibility="Collapsed" />
                        </StackPanel>
                        <Border x:Name="SelectedIndicator"
                                Height="{StaticResource SUI.Control.TabIndicatorThickness}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource SUI.Brush.Accent}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusOutline"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource SUI.Border.Thickness}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:TabControlAssist.IsClosable" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                            <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
