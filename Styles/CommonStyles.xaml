<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 通用排版与内容分隔线样式 -->
    <Style x:Key="SUI.Text.PageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SUI.Text.SectionHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SUI.Text.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SUI.Separator" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="Height" Value="{StaticResource SUI.Border.StrokeThickness}" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通用卡片面板容器（可用于多字段表单分组、信息区等） -->
    <Style x:Key="SUI.Border.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource SUI.Border.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource SUI.Radius.Panel}" />
        <Setter Property="Padding" Value="{StaticResource SUI.Space.CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
