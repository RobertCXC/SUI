<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sui="clr-namespace:SUI;assembly=SUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Geometry x:Key="SUITreeFolderIconGeometry">M 3,5 C 3,3.895 3.895,3 5,3 H 9 L 11,5 H 19 C 20.105,5 21,5.895 21,7 V 17 C 21,18.105 20.105,19 19,19 H 5 C 3.895,19 3,18.105 3,17 Z</Geometry>
    <Geometry x:Key="SUITreeLeafIconGeometry">M 5,3 H 19 C 20.105,3 21,3.895 21,5 V 19 C 21,20.105 21,21 19,21 H 5 C 3.895,21 3,20.105 3,19 V 5 C 3,3.895 3.895,3 5,3 Z M 7,7 H 17 V 9 H 7 Z M 7,11 H 15 V 13 H 7 Z M 7,15 H 12 V 17 H 7 Z</Geometry>
    <Geometry x:Key="SUITreeChevronRightGeometry">M 8,5 L 14,11 L 8,17</Geometry>
    <Geometry x:Key="SUITreeChevronDownGeometry">M 5,8 L 11,14 L 17,8</Geometry>

    <Style x:Key="SUITreeExpanderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Path x:Name="RightChevron"
                              Width="8"
                              Height="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource SUITreeChevronRightGeometry}"
                              Fill="Transparent"
                              Stretch="Fill"
                              Stroke="{StaticResource SUI.Brush.TextSecondary}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5" />
                        <Path x:Name="DownChevron"
                              Width="12"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource SUITreeChevronDownGeometry}"
                              Fill="Transparent"
                              Stretch="Fill"
                              Stroke="{StaticResource SUI.Brush.Accent}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5"
                              Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RightChevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DownChevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RightChevron" Property="Stroke" Value="{StaticResource SUI.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RightChevron" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="DownChevron" Property="Stroke" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SUITreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemMinHeight)}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemFontSize)}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ItemBorder"
                                Grid.Row="0"
                                Margin="0,2,4,2"
                                Padding="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemCornerRadius)}"
                                SnapsToDevicePixels="True">
                            <Grid MinHeight="{TemplateBinding MinHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectionIndicator"
                                        Grid.Column="0"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource SUI.Brush.Accent}"
                                        CornerRadius="{StaticResource SUI.Radius.Control}"
                                        Visibility="Collapsed" />

                                <ToggleButton x:Name="Expander"
                                              Grid.Column="1"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource SUITreeExpanderStyle}" />

                                <Path x:Name="FolderIcon"
                                      Grid.Column="2"
                                      Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource SUITreeFolderIconGeometry}"
                                      Fill="{StaticResource SUI.Brush.Accent}"
                                      Stretch="Fill"
                                      Visibility="Collapsed" />
                                <Path x:Name="LeafIcon"
                                      Grid.Column="2"
                                      Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource SUITreeLeafIconGeometry}"
                                      Fill="{StaticResource SUI.Brush.TextSecondary}"
                                      Stretch="Fill" />

                                <ContentPresenter x:Name="HeaderHost"
                                                  Grid.Column="3"
                                                  Margin="8,0,10,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>

                        <Grid x:Name="ChildrenContainer"
                              Grid.Row="1"
                              Margin="0"
                              Visibility="Collapsed">
                            <Border Width="1"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource SUI.Brush.Border}" />
                            <ItemsPresenter Margin="18,0,4,0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="FolderIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LeafIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChildrenContainer" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SUI.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SUI.Brush.Selected}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderHost" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource SUI.Brush.Focus}" />
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="{StaticResource SUI.Border.Thickness}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource SUITreeViewItemStyle}" />
</ResourceDictionary>
