<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sui="clr-namespace:SUI;assembly=SUI">

    <!--
        通用 TreeView 视觉资源。
        节点只需要提供 Title、OI 和 Children 属性即可复用这套样式。
        颜色、尺寸和圆角通过 TreeStyles 附加属性从宿主 TreeView 传入。
    -->
    <Geometry x:Key="SUITreeFolderIconGeometry">M 3,5 C 3,3.895 3.895,3 5,3 H 9 L 11,5 H 19 C 20.105,5 21,5.895 21,7 V 17 C 21,18.105 20.105,19 19,19 H 5 C 3.895,19 3,18.105 3,17 Z</Geometry>
    <Geometry x:Key="SUITreeLeafIconGeometry">M 5,3 H 19 C 20.105,3 21,3.895 21,5 V 19 C 21,20.105 20.105,21 19,21 H 5 C 3.895,21 3,20.105 3,19 V 5 C 3,3.895 3.895,3 5,3 Z M 7,7 H 17 V 9 H 7 Z M 7,11 H 15 V 13 H 7 Z M 7,15 H 12 V 17 H 7 Z</Geometry>
    <Geometry x:Key="SUITreeChevronRightGeometry">M 8,5 L 14,11 L 8,17</Geometry>
    <Geometry x:Key="SUITreeChevronDownGeometry">M 5,8 L 11,14 L 17,8</Geometry>

    <Style x:Key="SUITreeExpanderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent">
                        <Path x:Name="RightChevron"
                              Width="8"
                              Height="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource SUITreeChevronRightGeometry}"
                              Fill="Transparent"
                              Stretch="Fill"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ChevronBrush)}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5" />
                        <Path x:Name="DownChevron"
                              Width="12"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource SUITreeChevronDownGeometry}"
                              Fill="Transparent"
                              Stretch="Fill"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ExpandedChevronBrush)}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5"
                              Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RightChevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DownChevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RightChevron" Property="Stroke" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ExpandedChevronBrush)}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SUITreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemBackgroundBrush)}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemMinHeight)}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemFontSize)}" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemForegroundBrush)}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ItemBorder"
                                Grid.Row="0"
                                Margin="0,2,4,2"
                                Padding="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.ItemCornerRadius)}"
                                SnapsToDevicePixels="True">
                            <Grid MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectionIndicator"
                                        Grid.Column="0"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.SelectionIndicatorBrush)}"
                                        CornerRadius="2"
                                        Visibility="Collapsed" />

                                <ToggleButton x:Name="Expander"
                                              Grid.Column="1"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource SUITreeExpanderStyle}" />

                                <Path x:Name="FolderIcon"
                                      Grid.Column="2"
                                      Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource SUITreeFolderIconGeometry}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.FolderIconBrush)}"
                                      Stretch="Fill"
                                      Visibility="Collapsed" />
                                <Path x:Name="LeafIcon"
                                      Grid.Column="2"
                                      Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.IconSize)}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource SUITreeLeafIconGeometry}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.LeafIconBrush)}"
                                      Stretch="Fill" />

                                <ContentPresenter Grid.Column="3"
                                                  Margin="8,0,10,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>

                        <Grid x:Name="ChildrenContainer"
                              Grid.Row="1"
                              Margin="0"
                              Visibility="Collapsed">
                            <Border Width="1"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.HierarchyLineBrush)}" />
                            <ItemsPresenter Margin="18,0,4,0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="FolderIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LeafIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChildrenContainer" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.HoverItemBackgroundBrush)}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.SelectedItemBackgroundBrush)}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.SelectedItemForegroundBrush)}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 适用于具有 Title、OI、Children 属性的任意树节点。 -->
    <HierarchicalDataTemplate x:Key="SUITreeNodeTemplate" ItemsSource="{Binding Children}">
        <Grid Margin="0" MinHeight="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Title}" />
            <Border x:Name="OIBadge"
                    Grid.Column="1"
                    Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.OIColumnWidth)}"
                    Margin="12,0,4,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OI}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.OIFontSize)}"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=(sui:TreeStyles.OIForegroundBrush)}"
                           Text="{Binding OI}"
                           TextAlignment="Right"
                           ToolTip="对象标识（OI）" />
            </Border>
        </Grid>
    </HierarchicalDataTemplate>

</ResourceDictionary>
