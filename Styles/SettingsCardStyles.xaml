<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SUI;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:SUISettingsCard}">
        <Setter Property="Background" Value="{StaticResource SUI.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource SUI.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource SUI.Border.Thickness}" />
        <Setter Property="Foreground" Value="{StaticResource SUI.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource SUI.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource SUI.Font.Size.Body}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SUISettingsCard}">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SUI.Radius.Panel}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="IconText"
                                       Grid.Column="0"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource SUI.Font.Icon}"
                                       FontSize="16"
                                       Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                       Text="{TemplateBinding IconGlyph}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DescriptionText"
                                           Margin="0,2,0,0"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{StaticResource SUI.Font.Size.Caption}"
                                           Foreground="{StaticResource SUI.Brush.TextSecondary}"
                                           Text="{TemplateBinding Description}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ContentPresenter x:Name="ActionPresenter"
                                              Grid.Column="2"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Content"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconGlyph" Value="{x:Null}">
                            <Setter TargetName="IconText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IconGlyph" Value="">
                            <Setter TargetName="IconText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ActionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SUI.Brush.Disabled}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                            <Setter TargetName="DescriptionText" Property="Foreground" Value="{StaticResource SUI.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
