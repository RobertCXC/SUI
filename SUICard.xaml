<UserControl
    x:Class="SUI.SUICard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="70"
    d:DesignWidth="260"
    mc:Ignorable="d">
    <Border
        Padding="{StaticResource SUI.Space.DataGridCellPadding}"
        Background="{StaticResource SUI.Brush.Surface}"
        BorderBrush="{StaticResource SUI.Brush.Border}"
        BorderThickness="{StaticResource SUI.Border.Thickness}"
        CornerRadius="{StaticResource SUI.Radius.Panel}"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧图标区域（默认一个带"M"的色块），如果设置了 IconSource，会覆盖显示在文字上方  -->
            <Border
                Grid.Column="0"
                Width="48"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CornerRadius="{StaticResource SUI.Radius.Panel}">
                <Grid>
                    <!--  默认图标（一个字母）。当 IconSource 为空时可见；有图片时自动隐藏  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource SUI.Font.Size.Title}"
                        FontWeight="Bold"
                        Foreground="{StaticResource SUI.Brush.TextOnAccent}"
                        Text="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  使用圆角边框 + ImageBrush 作为背景，保证图片显示为圆角  -->
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="{StaticResource SUI.Radius.Panel}">
                        <Border.Background>
                            <ImageBrush
                                AlignmentX="Center"
                                AlignmentY="Center"
                                ImageSource="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Stretch="Uniform" />
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>

            <!--  右侧标题与描述  -->
            <StackPanel
                Grid.Column="1"
                Margin="{StaticResource SUI.Space.ButtonPadding}"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="{StaticResource SUI.Font.Size.Title}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SUI.Brush.Text}"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock
                    Margin="{StaticResource SUI.Space.MenuSeparatorMargin}"
                    FontSize="{StaticResource SUI.Font.Size.Caption}"
                    Foreground="{StaticResource SUI.Brush.TextSecondary}"
                    Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
