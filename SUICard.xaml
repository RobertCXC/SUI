<UserControl
    x:Class="SUI.SUICard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="70"
    d:DesignWidth="260"
    mc:Ignorable="d">
    <Border
        MaxWidth="300"
        Padding="10"
        Background="White"
        CornerRadius="12"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Opacity="0.6"
                ShadowDepth="3"
                Color="#33000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧图标区域（默认一个带"M"的色块），如果设置了 IconSource，会覆盖显示在文字上方  -->
            <Border
                Grid.Column="0"
                Width="48"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CornerRadius="10">
                <Grid>
                    <!--  默认图标（一个字母）。当 IconSource 为空时可见；有图片时自动隐藏  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  使用圆角边框 + ImageBrush 作为背景，保证图片显示为圆角  -->
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="8">
                        <Border.Background>
                            <ImageBrush
                                AlignmentX="Center"
                                AlignmentY="Center"
                                ImageSource="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Stretch="Uniform" />
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>

            <!--  右侧标题与描述  -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#1F1F1F"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="#7A7A7A"
                    Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
